---
import type { CollectionEntry } from "astro:content";

interface Props {
  newsItems: CollectionEntry<"news">[];
  title?: string;
}

const { newsItems, title = "News" } = Astro.props;

const LANG_LABELS: Record<string, string> = {
  en: "English",
  ml: "മലയാളം",
  hi: "हिंदी",
};

const langOrder = ["en", "ml", "hi"];

const sorted = [...newsItems].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const grouped = sorted.reduce(
  (acc, item) => {
    const lang = item.data.language;
    if (!acc[lang]) acc[lang] = [];
    acc[lang].push(item);
    return acc;
  },
  {} as Record<string, typeof sorted>,
);

const activeLangs = langOrder.filter((l) => grouped[l]?.length > 0);
---

<aside class="side-panel">
  <div class="side-panel-header">{title}</div>

  {
    activeLangs.map((lang) => (
      <div class="side-lang-group">
        <div class="side-lang-title">
          <span>{LANG_LABELS[lang] ?? lang}</span>
          <span class="side-lang-count">{grouped[lang].length}</span>
        </div>
        <ul class="side-list">
          {grouped[lang].map((item) => (
            <li>
              <a href={`/news/${item.id}`} class="side-link">
                {item.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</aside>

<style>
  .side-panel {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    position: sticky;
    top: calc(var(--navbar-height) + 16px);
    max-height: calc(100vh - var(--navbar-height) - 32px);
    overflow-y: auto;
  }

  .side-panel-header {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--red);
  }

  .side-lang-group {
    margin-bottom: 18px;
  }

  .side-lang-group:last-child {
    margin-bottom: 0;
  }

  .side-lang-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 700;
    color: var(--red);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 8px;
  }

  .side-lang-count {
    font-size: 10px;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-page);
    padding: 1px 7px;
    border-radius: 10px;
    text-transform: none;
    letter-spacing: 0;
  }

  .side-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .side-link {
    display: block;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    line-height: 1.4;
  }

  .side-link:hover {
    color: var(--red);
  }

  @media (max-width: 1024px) {
    .side-panel {
      position: static;
      max-height: none;
    }
  }
</style>
