---
import type { CollectionEntry } from "astro:content";

interface Props {
  newsItems: CollectionEntry<"news">[];
  title?: string;
  collapsible?: boolean;
}

const { newsItems, title = "News", collapsible = false } = Astro.props;

const LANG_LABELS: Record<string, string> = {
  en: "English",
  ml: "മലയാളം",
  hi: "हिंदी",
};

const langOrder = ["en", "ml", "hi"];

const sorted = [...newsItems].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const grouped = sorted.reduce(
  (acc, item) => {
    const lang = item.data.language;
    if (!acc[lang]) acc[lang] = [];
    acc[lang].push(item);
    return acc;
  },
  {} as Record<string, typeof sorted>,
);

const activeLangs = langOrder.filter((l) => grouped[l]?.length > 0);

const searchData = sorted.map((item) => ({
  id: item.id,
  title: item.data.title,
  url: `/news/${item.id}`,
}));

// unique IDs so multiple instances on same page don't clash
const uid = collapsible ? "news-acc" : "news-side";
---

{collapsible ? (
  <details class="accordion">
    <summary class="accordion-summary">
      <span class="accordion-label">{title}</span>
      <svg class="accordion-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </summary>
    <div class="accordion-body">
      <div class="side-search-wrap">
        <div class="side-search-inner">
          <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"/>
            <line x1="16.5" y1="16.5" x2="22" y2="22"/>
          </svg>
          <input data-news-search={uid} type="text" placeholder="Search news…" autocomplete="off" spellcheck="false" />
          <button data-news-clear={uid} class="clear-btn" aria-label="Clear search" hidden>✕</button>
        </div>
      </div>
      <div data-news-grouped={uid}>
        {activeLangs.map((lang) => (
          <div class="side-lang-group">
            <div class="side-lang-title">
              <span>{LANG_LABELS[lang] ?? lang}</span>
              <span class="side-lang-count">{grouped[lang].length}</span>
            </div>
            <ul class="side-list">
              {grouped[lang].map((item) => (
                <li>
                  <a href={`/news/${item.id}`} class="side-link">{item.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div data-news-results={uid} hidden>
        <div data-news-count={uid} class="results-count"></div>
        <div data-news-list={uid} class="results-list"></div>
        <div data-news-empty={uid} class="no-results" hidden>No news found.</div>
      </div>
    </div>
  </details>
) : (
  <aside class="side-panel">
    <div class="side-panel-header">{title}</div>
    <div class="side-search-wrap sticky-search">
      <div class="side-search-inner">
        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"/>
          <line x1="16.5" y1="16.5" x2="22" y2="22"/>
        </svg>
        <input data-news-search={uid} type="text" placeholder="Search news…" autocomplete="off" spellcheck="false" />
        <button data-news-clear={uid} class="clear-btn" aria-label="Clear search" hidden>✕</button>
      </div>
    </div>
    <div class="side-panel-body" data-news-grouped={uid}>
      {activeLangs.map((lang) => (
        <div class="side-lang-group">
          <div class="side-lang-title">
            <span>{LANG_LABELS[lang] ?? lang}</span>
            <span class="side-lang-count">{grouped[lang].length}</span>
          </div>
          <ul class="side-list">
            {grouped[lang].map((item) => (
              <li>
                <a href={`/news/${item.id}`} class="side-link">{item.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="side-panel-body" data-news-results={uid} hidden>
      <div data-news-count={uid} class="results-count"></div>
      <div data-news-list={uid} class="results-list"></div>
      <div data-news-empty={uid} class="no-results" hidden>No news found.</div>
    </div>
  </aside>
)}

<script define:vars={{ searchData, uid }}>
  const input      = document.querySelector(`[data-news-search="${uid}"]`);
  const clearBtn   = document.querySelector(`[data-news-clear="${uid}"]`);
  const groupedEl  = document.querySelector(`[data-news-grouped="${uid}"]`);
  const resultsEl  = document.querySelector(`[data-news-results="${uid}"]`);
  const listEl     = document.querySelector(`[data-news-list="${uid}"]`);
  const countEl    = document.querySelector(`[data-news-count="${uid}"]`);
  const emptyEl    = document.querySelector(`[data-news-empty="${uid}"]`);

  if (!input) return;

  function highlight(text, query) {
    if (!query) return text;
    const q = query.trim();
    if (!q) return text;
    return text.replace(/\S+/gu, (word) =>
      word.toLowerCase().includes(q.toLowerCase())
        ? `<mark>${word}</mark>`
        : word
    );
  }

  function runSearch(raw) {
    const q = raw.trim().toLowerCase();
    if (!q) {
      groupedEl.hidden = false;
      resultsEl.hidden = true;
      clearBtn.hidden  = true;
      return;
    }
    clearBtn.hidden  = false;
    groupedEl.hidden = true;
    resultsEl.hidden = false;

    const hits = searchData.filter((a) => a.title.toLowerCase().includes(q));
    listEl.innerHTML  = "";
    emptyEl.hidden    = hits.length > 0;
    countEl.textContent = hits.length > 0
      ? `${hits.length} result${hits.length !== 1 ? "s" : ""}`
      : "";

    hits.forEach((item) => {
      const card = document.createElement("a");
      card.href = item.url;
      card.className = "sidebar-result-card";
      card.innerHTML = `<span class="sidebar-result-title">${highlight(item.title, raw.trim())}</span>`;
      listEl.appendChild(card);
    });
  }

  input.addEventListener("input",  (e) => runSearch(e.target.value));
  clearBtn.addEventListener("click", () => { input.value = ""; input.focus(); runSearch(""); });
</script>

<style>
  .side-panel {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: 12px;
    position: sticky;
    top: calc(var(--navbar-height) + 16px);
    max-height: calc(100vh - var(--navbar-height) - 32px);
    overflow-y: auto;
  }

  .side-panel-header {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--text-primary);
    border-radius: 12px 12px 0 0;
    font-size: 14px;
    font-weight: 700;
    color: var(--red);
    padding: 16px 20px;
    border-bottom: 2px solid var(--red);
  }

  .side-search-wrap {
    padding: 12px 16px 8px;
  }

  .sticky-search {
    position: sticky;
    top: 51px;
    z-index: 1;
    background: var(--bg-white);
  }

  .side-search-inner {
    display: flex;
    align-items: center;
    gap: 7px;
    background: var(--bg-page);
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: 7px 10px;
    transition: border-color 0.15s;
  }

  .side-search-inner:focus-within {
    border-color: var(--red);
    background: var(--bg-white);
  }

  .search-icon { flex-shrink: 0; color: var(--text-muted); }

  [data-news-search] {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 13px;
    color: var(--text-primary);
    outline: none;
    min-width: 0;
    font-family: var(--font-body);
  }

  [data-news-search]::placeholder { color: var(--text-muted); }

  .clear-btn {
    border: none;
    background: none;
    cursor: pointer;
    color: var(--text-muted);
    font-size: 12px;
    padding: 0 2px;
    line-height: 1;
    flex-shrink: 0;
    transition: color 0.15s;
  }
  .clear-btn:hover { color: var(--red); }

  .side-panel-body { padding: 8px 16px 20px; }

  .side-lang-group { margin-bottom: 18px; }
  .side-lang-group:last-child { margin-bottom: 0; }

  .side-lang-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 700;
    color: var(--red);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 8px;
  }

  .side-lang-count {
    font-size: 10px;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-page);
    padding: 1px 7px;
    border-radius: 10px;
    text-transform: none;
    letter-spacing: 0;
  }

  .side-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .side-link {
    display: block;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    line-height: 1.4;
  }
  .side-link:hover { color: var(--red); }

  .results-count {
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 8px;
    font-weight: 500;
  }
  .results-list { display: flex; flex-direction: column; gap: 6px; }
  .no-results { font-size: 13px; color: var(--text-muted); text-align: center; padding: 20px 0 8px; }

  /* ── ACCORDION ───────────────────────────────── */
  .accordion {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .accordion-summary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 18px;
    cursor: pointer;
    list-style: none;
    background: var(--bg-white);
    border-bottom: 2px solid var(--red);  /* always show red border, not just open */
    user-select: none;
  }

  .accordion-label {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
    flex: 1;
  }
  .accordion-summary::-webkit-details-marker { display: none; }

  details[open] > .accordion-summary { border-bottom-color: var(--red); }

  .accordion-count {
    font-size: 11px;
    background: var(--bg-page);
    color: var(--text-muted);
    padding: 2px 8px;
    border-radius: 10px;
    font-weight: 600;
  }

  .accordion-chevron {
    color: var(--text-muted);
    transition: transform 0.2s;
    flex-shrink: 0;
  }
  details[open] .accordion-chevron { transform: rotate(180deg); }

  .accordion-body { padding: 12px 16px 16px; }
  .accordion-body .side-search-wrap { padding: 0 0 12px; }
  .accordion-body .side-lang-group { margin-bottom: 14px; }

  @media (max-width: 1024px) {
    .side-panel { position: static; max-height: none; }
    .sticky-search { position: static; }
  }
</style>

<style is:global>
  .sidebar-result-card {
    display: flex;
    flex-direction: column;
    padding: 9px 11px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg-page);
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .sidebar-result-card:hover { border-color: var(--red); background: #fffbf0; }
  .sidebar-result-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    line-height: 1.4;
  }
  .sidebar-result-card:hover .sidebar-result-title { color: var(--red); }
  .sidebar-result-card mark {
    background: #fff3a3;
    color: inherit;
    border-radius: 2px;
    padding: 0 1px;
  }
</style>