---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE } from "../consts";
import ArticlesByLanguageSidebar from "../components/ArticlesByLanguageSidebar.astro";
import NewsByLanguageSidebar from "../components/NewsByLanguageSidebar.astro";
import { getCollection } from "astro:content";

const allArticles = await getCollection("blog");
const allNews = await getCollection("news");

const archive = [
  {
    year: 2026,
    months: [
      {
        name: "January - February",
        file: "/archive/2026/January-February.pdf",
      },
      {
        name: "April - May",
        file: "/archive/2026/April-May.pdf",
      },
    ],
  },
  {
    year: 2025,
    months: [
      {
        name: "November - December",
        file: "/archive/2025/November-December.pdf",
      },
      {
        name: "September - October",
        file: "/archive/2025/September-October.pdf",
      },
      {
        name: "July - August",
        file: "/archive/2025/July-August.pdf",
      },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Archive | ${SITE_TITLE}`}
      description="Archive of past Sadhwartha publications"
    />
  </head>
  <body>
    <Navbar />

    <main class="page-wrap">
      <div class="page-header">
        <div class="page-title">Archive</div>
        <div class="page-sub">Past publications available as PDF downloads</div>
      </div>

      <div class="archive-layout">
        <!-- LEFT SIDEBAR -->
        <div class="blog-sidebar">
          <div class="sidebar-desktop">
            <ArticlesByLanguageSidebar
              articles={allArticles}
              title="All Articles"
            />
          </div>

          <div class="sidebar-accordion">
            <ArticlesByLanguageSidebar
              articles={allArticles}
              title="All Articles"
              collapsible={true}
            />
          </div>
        </div>

        <!-- MAIN CONTENT -->
        <div class="archive-main">
          <div class="archive-wrap">
            {
              archive.map((group) => (
                <div class="year-group">
                  <div class="year-label">{group.year}</div>

                  <div class="month-list">
                    {group.months.map((month) => (
                      <a href={month.file} target="_blank" class="month-row">
                        <div class="month-left">
                          <span class="month-icon">↓</span>
                          <span class="month-name">
                            {month.name} {group.year}
                          </span>
                        </div>

                        <span class="pdf-badge">PDF</span>
                      </a>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- RIGHT SIDEBAR -->
        <div class="blog-sidebar-right">
          <div class="sidebar-desktop">
            <NewsByLanguageSidebar newsItems={allNews} title="News" />
          </div>

          <div class="sidebar-accordion">
            <NewsByLanguageSidebar
              newsItems={allNews}
              title="News"
              collapsible={true}
            />
          </div>
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(body) {
    background: var(--bg-page);
  }

  main {
    min-height: calc(100vh - 58px - 200px);
  }

  .page-wrap {
    flex: 1;
    padding: 0 16px;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }

  .page-header {
    background: var(--text-primary);
    border-radius: 12px;
    padding: 28px 32px;
    margin: 6rem 0 1.5rem;
  }

  .page-title {
    font-size: 26px;
    font-weight: 700;
    color: var(--red);
    margin-bottom: 4px;
  }

  .page-sub {
    font-size: 13px;
    color: var(--text-muted);
  }

  /* New styles */
  .archive-layout {
    display: grid;
    grid-template-columns: 260px 1fr 260px;
    gap: 24px;
    align-items: start;
  }

  .blog-sidebar {
    order: 1;
  }

  .archive-main {
    order: 2;
    min-width: 0;
  }

  .blog-sidebar-right {
    order: 3;
  }

  .sidebar-accordion {
    display: none;
  }

  .sidebar-desktop {
    display: block;
  }

  /* ── ARCHIVE LIST ──────────────────────────────── */
  .archive-wrap {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .year-group {
    background: var(--slate);
    border: 1px solid var(--text-dark);
    border-radius: 12px;
    overflow: hidden;
  }

  .year-label {
    background: var(--navy);
    color: var(--red);
    font-size: 12px;
    font-weight: 600;
    padding: 12px 20px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--text-dark);
  }

  .month-list {
    padding: 0;
  }

  .month-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--text-dark);
    text-decoration: none;
    color: var(--bg-white);
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .month-row:last-child {
    border-bottom: none;
  }

  .month-row:hover {
    background: var(--text-dark);
    color: var(--red);
  }

  .month-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .month-icon {
    font-size: 16px;
    color: var(--red);
    font-weight: 600;
  }

  .month-name {
    font-size: 15px;
    color: inherit;
    font-weight: 500;
  }

  .pdf-badge {
    font-size: 10px;
    padding: 3px 10px;
    border-radius: 16px;
    background: var(--red);
    color: var(--bg-white);
    border: none;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* ── RESPONSIVE ────────────────────────────────── */
  @media (max-width: 1024px) {
    .archive-layout {
      grid-template-columns: 1fr 220px;
      grid-template-rows: auto auto;
      gap: 16px;
    }

    .blog-sidebar {
      grid-column: 2;
      grid-row: 1;
    }

    .blog-sidebar-right {
      grid-column: 2;
      grid-row: 2;
      margin-top: 0;
    }

    .archive-main {
      grid-column: 1;
      grid-row: 1 / 3;
    }

    .sidebar-desktop {
      display: none;
    }

    .sidebar-accordion {
      display: block;
    }
  }

  @media (max-width: 768px) {
    main {
      padding: 1.5rem 0.75rem;
      min-height: auto;
    }

    .page-wrap {
      max-width: 100%;
      padding: 1rem 1rem;
    }

    .page-header {
      padding: 20px 16px;
      margin: 4rem 0 1.5rem;
    }

    .page-title {
      font-size: 22px;
    }

    .page-sub {
      font-size: 13px;
    }

    .month-row {
      padding: 12px 16px;
      flex-wrap: wrap;
      gap: 8px;
    }

    .pdf-badge {
      padding: 2px 8px;
      font-size: 9px;
    }
  }

  @media (max-width: 680px) {
    .archive-layout {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .archive-main {
      width: 100%;
      order: 1;
    }

    .blog-sidebar {
      width: 100%;
      order: 2;
    }

    .blog-sidebar-right {
      width: 100%;
      order: 3;
    }

    .sidebar-desktop {
      display: none;
    }

    .sidebar-accordion {
      display: block;
    }
  }

  @media (max-width: 480px) {
    .page-wrap {
      max-width: 100%;
      padding: 0rem 1rem;
    }
    .page-header {
      padding: 20px;
      margin: 4.5rem 0 1.5rem;
    }
  }
</style>
