---
import BaseHead from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const archive = [
  {
    year: 2026,
    months: [
      { name: 'January', file: '/archive/2026/January.pdf' },
    ]
  },
  {
    year: 2025,
    months: [
      { name: 'October', file: '/archive/2025/October.pdf' },
    ]
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Archive | ${SITE_TITLE}`} description="Archive of past Sadhwartha publications" />
  </head>
  <body>

    <Navbar />

    <main class="page-wrap">

      <div class="page-header">
        <div class="page-title">Archive</div>
        <div class="page-sub">Past publications available as PDF downloads</div>
      </div>

      <div class="archive-wrap">
        {archive.map((group) => (
          <div class="year-group">
            <div class="year-label">{group.year}</div>
            <div class="month-list">
              {group.months.map((month) => (
                <a href={month.file} target="_blank" class="month-row">
                  <div class="month-left">
                    <span class="month-icon">↓</span>
                    <span class="month-name">{month.name} {group.year}</span>
                  </div>
                  <span class="pdf-badge">PDF</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

    </main>

    <Footer />

  </body>
</html>

<style>
  :global(body) {
    background: var(--bg-page);
  }

  main {
    min-height: calc(100vh - 58px - 200px);
    padding: 2rem 1rem;
  }

  .page-wrap {
    max-width: 900px;
    margin: 0 auto;
  }

  .page-header {
    background: var(--slate);
    border-radius: 12px;
    padding: 32px 28px;
    margin-top: 60px;
    margin-bottom: 2rem;
    border: 1px solid var(--text-dark);
  }

  .page-title {
    font-size: 28px;
    font-weight: 600;
    color: var(--bg-white);
    letter-spacing: 0.04em;
    margin: 0 0 8px 0;
  }

  .page-sub {
    font-size: 14px;
    color: var(--text-muted);
    margin: 0;
  }

  /* ── ARCHIVE LIST ──────────────────────────────── */
  .archive-wrap {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .year-group {
    background: var(--slate);
    border: 1px solid var(--text-dark);
    border-radius: 12px;
    overflow: hidden;
  }

  .year-label {
    background: var(--navy);
    color: var(--orange-light);
    font-size: 12px;
    font-weight: 600;
    padding: 12px 20px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--text-dark);
  }

  .month-list {
    padding: 0;
  }

  .month-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--text-dark);
    text-decoration: none;
    color: var(--bg-white);
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .month-row:last-child {
    border-bottom: none;
  }

  .month-row:hover {
    background: var(--text-dark);
    color: var(--orange-light);
  }

  .month-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .month-icon {
    font-size: 16px;
    color: var(--orange-light);
    font-weight: 600;
  }

  .month-name {
    font-size: 15px;
    color: inherit;
    font-weight: 500;
  }

  .pdf-badge {
    font-size: 10px;
    padding: 3px 10px;
    border-radius: 16px;
    background: var(--orange);
    color: var(--bg-white);
    border: none;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* ── RESPONSIVE ────────────────────────────────── */
  @media (max-width: 768px) {
    main {
      padding: 1.5rem 0.75rem;
      min-height: auto;
    }

    .page-wrap {
      max-width: 100%;
    }

    .page-header {
      padding: 20px 16px;
      margin-top: 60px;
      margin-bottom: 1.5rem;
    }

    .page-title {
      font-size: 22px;
    }

    .page-sub {
      font-size: 13px;
    }

    .month-row {
      padding: 12px 16px;
      flex-wrap: wrap;
      gap: 8px;
    }

    .pdf-badge {
      padding: 2px 8px;
      font-size: 9px;
    }
  }
</style>

