---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE } from "../consts";

const pageTitle = `Contact Us | ${SITE_TITLE}`;
const pageDescription =
  "Get in touch with Sadhwartha. Send us your message and we'll respond as soon as possible.";

// Contact details
const contactInfo = {
  email: "sadhwartha@gmail.com",
  phone: "+91-8208907893",
  address: "Sadhwartha Publications P.O. Box No. 7213, Chembur, Mumbai 400071.",
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
  </head>

  <body>
    <Navbar />

    <!-- ── PAGE CONTENT ──────────────────────────────── -->
    <main class="page-wrap">
      <div class="page-header">
        <div class="page-title">Contact Us</div>
        <div class="page-sub">Get in touch with Sadhwartha.</div>
      </div>

      <!-- Three Column Info Cards -->
      <div class="info-cards-container">
        <a
          href="https://maps.app.goo.gl/JrRGP4BoXTUwRqza9"
          target="_blank"
          rel="noopener noreferrer"
          class="info-card-link"
        >
          <div class="info-card-col">
            <div class="icon-circle">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="28"
                height="28"
              >
                <path
                  d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                ></path>
              </svg>
            </div>
            <h3 class="info-col-title">Our Address</h3>
            <p class="info-col-text">{contactInfo.address}</p>
          </div>
        </a>

        <a
          href={`tel:${contactInfo.phone.replace(/[^+\d]/g, "")}`}
          class="info-card-link"
        >
          <div class="info-card-col">
            <div class="icon-circle">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="28"
                height="28"
              >
                <path
                  d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
                ></path>
              </svg>
            </div>
            <h3 class="info-col-title">Phone Number</h3>
            <p class="info-col-text">{contactInfo.phone}</p>
          </div>
        </a>

        <a href={`mailto:${contactInfo.email}`} class="info-card-link">
          <div class="info-card-col">
            <div class="icon-circle">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="28"
                height="28"
              >
                <path
                  d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
                ></path>
              </svg>
            </div>
            <h3 class="info-col-title">Email Us</h3>
            <p class="info-col-text">{contactInfo.email}</p>
          </div>
        </a>
      </div>

      <div class="contact-container">
        <!-- Contact Form -->
        <div class="contact-form-wrapper">
          <div class="form-header">
            <h2 class="form-title">Send us a Message</h2>
          </div>

          <form
            class="contact-form"
            name="contact"
            method="POST"
            data-netlify="true"
          >
            <div class="form-row">
              <div class="form-group">
                <label for="name" class="form-label">Full Name</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  class="form-input"
                  placeholder="Your name"
                  required
                />
              </div>

              <div class="form-group">
                <label for="email" class="form-label">Email Address</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="form-input"
                  placeholder="your.email@example.com"
                  required
                />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="phone" class="form-label">Phone Number</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="form-input"
                  placeholder="+91-XXXXXXXXXX"
                  required
                />
              </div>

              <div class="form-group">
                <label for="subject" class="form-label">Subject</label>
                <input
                  type="text"
                  id="subject"
                  name="subject"
                  class="form-input"
                  placeholder="What is this about?"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label for="message" class="form-label">Message</label>
              <textarea
                id="message"
                name="message"
                class="form-textarea"
                placeholder="Write your message here..."
                rows="6"
                required></textarea>
            </div>

            <button type="submit" class="btn-submit">Send Message</button>
          </form>
        </div>

        <!-- Contact Info Sidebar -->
        <div class="contact-info-wrapper">
          <!-- Article Submission -->
          <div class="article-submission-card">
            <h3 class="info-title">Submit Your Article</h3>
            <p class="article-description">
              Have an article you'd like to share with us? Send it over to us!
            </p>

            <div class="submission-methods">
              <a href={`mailto:${contactInfo.email}`} class="submission-method">
                <svg
                  class="submission-icon email-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  width="24"
                  height="24"
                >
                  <path
                    d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
                  ></path>
                </svg>
                <div class="submission-info">
                  <p class="submission-label">Email</p>
                  <p class="submission-value">{contactInfo.email}</p>
                </div>
              </a>

              <a
                href="https://wa.me/918208907893"
                target="_blank"
                rel="noopener noreferrer"
                class="submission-method"
              >
                <svg
                  class="submission-icon whatsapp-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  width="24"
                  height="24"
                >
                  <path
                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                  ></path>
                </svg>
                <div class="submission-info">
                  <p class="submission-label">WhatsApp</p>
                  <p class="submission-value">{contactInfo.phone}</p>
                </div>
              </a>
            </div>

            <p class="submission-note-compact">
              Include your name, article title, a single sentance description,
              content, and images.
            </p>
          </div>
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--bg-page);
    font-family: var(
      --font-body
    ); /* inherits per-language font from global.css */
  }

  main {
    min-height: calc(100vh - 58px - 200px);
  }

  /* ── HEADER SECTION ──────────────────────────────────── */
  .page-wrap {
    flex: 1;
    padding: 0 16px;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }

  .page-header {
    background: var(--text-primary);
    border-radius: 12px;
    padding: 28px 32px;
    margin: 6rem 0 2rem;
  }

  .page-title {
    font-size: 26px;
    font-weight: 700;
    color: var(--red);
    margin-bottom: 4px;
  }

  .page-sub {
    font-size: 13px;
    color: var(--text-muted);
  }

  /* ── THREE COLUMN INFO CARDS ──────────────────────────── */
  .info-cards-container {
    margin-bottom: 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .info-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .info-card-link:hover {
    text-decoration: none;
  }

  .info-card-link .info-card-col {
    height: 100%;
    cursor: pointer;
  }

  .info-card-col {
    background: white;
    border-radius: 12px;
    padding: 40px 32px;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .info-card-col:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
  }

  .icon-circle {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #dbeafe;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
  }

  .icon-circle svg {
    color: #1d4ed8;
  }

  .info-col-title {
    font-size: 18px;
    font-weight: 700;
    color: #003049;
    margin-bottom: 12px;
  }

  .info-col-text {
    font-size: 14px;
    color: #64748b;
    line-height: 1.6;
    white-space: pre-line;
  }

  .contact-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  /* ── CONTACT FORM ──────────────────────────────────── */
  .contact-form-wrapper {
    background: white;
    padding: 40px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .form-header {
    margin-bottom: 32px;
  }

  .form-title {
    font-size: 28px;
    font-weight: 700;
    color: #003049;
    margin-bottom: 8px;
  }

  .form-subtitle {
    font-size: 14px;
    color: #64748b;
  }

  .form-group {
    margin-bottom: 24px;
  }

  .form-row {
    display: block;
  }

  @media (min-width: 1025px) {
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 24px;
    }

    .form-row .form-group {
      margin-bottom: 0;
    }
  }

  .form-label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 8px;
  }

  .form-input,
  .form-textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    font-family: inherit;
    font-size: 14px;
    color: #1e293b;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .form-input:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--red);
    box-shadow: 0 0 0 3px rgba(122, 99, 99, 0.667);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .btn-submit {
    width: 100%;
    padding: 14px 24px;
    background: var(--red);
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition:
      background 0.2s ease,
      transform 0.1s ease;
  }

  .btn-submit:hover {
    filter: brightness(130%);
  }

  .btn-submit:active {
    transform: scale(0.98);
  }

  /* ── CONTACT INFO ──────────────────────────────────── */
  .contact-info-wrapper {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .info-title {
    font-size: 23px;
    font-weight: 700;
    color: #003049;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* ── ARTICLE SUBMISSION CARD ──────────────────────────────────── */
  .article-submission-card {
    background: white;
    padding: 32px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .article-description {
    font-size: 14px;
    color: #64748b;
    margin-bottom: 24px;
  }

  .submission-methods {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 20px;
  }

  .submission-method {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    background: #f8fafc;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
    border-left: 3px solid transparent;
  }

  .submission-method:hover {
    background: #f1f5f9;
    border-left-color: var(--red);
  }

  .submission-icon {
    display: block;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    color: #003049;
  }

  .submission-icon.email-icon {
    color: #d62828;
  }

  .submission-icon.whatsapp-icon {
    color: #25d366;
  }

  .submission-info {
    flex: 1;
  }

  .submission-label {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }

  .submission-value {
    font-size: 15px;
    color: #003049;
    font-weight: 500;
  }

  .submission-note-compact {
    font-size: 12px;
    color: #94a3b8;
    line-height: 1.5;
  }

  /* ──────────────────────────────────────────────────────── */
  /* RESPONSIVE: TABLET (768px and below) */
  /* ──────────────────────────────────────────────────────── */
  @media (max-width: 992px) {
    .page-header {
      padding: 20px 16px;
      margin: 4.5rem 0 1.5rem;
    }
  }

  @media (max-width: 768px) {
    main {
      padding: 1.5rem 0.75rem;
      min-height: auto;
    }

    .page-wrap {
      max-width: 100%;
      padding: 1rem 1rem;
    }

    .page-header {
      padding: 20px 16px;
      margin: 3.2rem 0 1.5rem;
    }

    .page-title {
      font-size: 22px;
    }

    .page-sub {
      font-size: 13px;
    }

    .info-cards-container {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 32px;
    }

    .contact-container {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .contact-form-wrapper {
      padding: 32px;
    }

    .form-title {
      font-size: 24px;
    }

    .article-submission-card {
      padding: 24px;
    }
  }

  @media (max-width: 480px) {
    .page-wrap {
      max-width: 100%;
      padding: 0rem 1rem;
    }

    .page-header {
      padding: 20px;
      margin: 4rem 0 1.5rem;
    }

    .contact-form-wrapper {
      padding: 24px;
    }

    .form-title {
      font-size: 20px;
    }

    .info-card-col {
      padding: 28px 20px;
    }

    .icon-circle {
      width: 56px;
      height: 56px;
    }

    .form-input,
    .form-textarea {
      padding: 10px 12px;
      font-size: 16px; /* Prevents zoom on mobile */
    }

    .info-title {
      font-size: 18px;
    }

    .article-submission-card {
      padding: 20px;
    }

    .submission-method {
      padding: 12px;
      gap: 10px;
    }

    .submission-icon {
      width: 20px;
      height: 20px;
    }

    .submission-value {
      font-size: 13px;
    }
  }
</style>
