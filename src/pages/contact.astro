---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE } from "../consts";

const pageTitle = `Contact Us | ${SITE_TITLE}`;
const pageDescription =
  "Get in touch with Sadhwartha. Send us your message and we'll respond as soon as possible.";

// Contact details
const contactInfo = {
  email: "sadhwartha@gmail.com",
  phone: "+91-8208907893",
  address: "Church of God (Full Gospel) in India\nCentral West Region",
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
  </head>

  <body>
    <Navbar />

    <!-- ── HERO SECTION ──────────────────────────────── -->
    <section class="hero">
      <div class="hero-content">
        <h1 class="hero-title">Get in touch with us</h1>
      </div>
    </section>

    <!-- ── MAIN CONTENT ──────────────────────────────── -->
    <section class="contact-section">
      <div class="contact-container">
        <!-- Contact Form -->
        <div class="contact-form-wrapper">
          <div class="form-header">
            <h2 class="form-title">Send us a Message</h2>
          </div>

          <form
            class="contact-form"
            name="contact"
            method="POST"
            data-netlify="true"
          >
            <div class="form-group">
              <label for="name" class="form-label">Full Name</label>
              <input
                type="text"
                id="name"
                name="name"
                class="form-input"
                placeholder="Your name"
                required
              />
            </div>

            <div class="form-group">
              <label for="email" class="form-label">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                class="form-input"
                placeholder="your.email@example.com"
                required
              />
            </div>

            <div class="form-group">
              <label for="phone" class="form-label">Phone Number</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="form-input"
                placeholder="+91-XXXXXXXXXX"
                required
              />
            </div>

            <div class="form-group">
              <label for="subject" class="form-label">Subject</label>
              <input
                type="text"
                id="subject"
                name="subject"
                class="form-input"
                placeholder="What is this about?"
                required
              />
            </div>

            <div class="form-group">
              <label for="message" class="form-label">Message</label>
              <textarea
                id="message"
                name="message"
                class="form-textarea"
                placeholder="Write your message here..."
                rows="6"
                required></textarea>
            </div>

            <button type="submit" class="btn-submit">Send Message</button>
          </form>
        </div>

        <!-- Contact Information -->
        <div class="contact-info-wrapper">
          <div class="info-card">
            <h3 class="info-title">Contact Information</h3>

            <a href={`mailto:${contactInfo.email}`} class="info-item">
              <svg
                class="info-icon email-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="24"
                height="24"
              >
                <path
                  d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
                ></path>
              </svg>
              <div class="info-content">
                <p class="info-label">Email</p>
                <p class="info-value">
                  {contactInfo.email}
                </p>
              </div>
            </a>

            <a href="tel:+918208907893" class="info-item">
              <svg
                class="info-icon phone-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="24"
                height="24"
              >
                <path
                  d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"
                ></path>
              </svg>
              <div class="info-content">
                <p class="info-label">Phone</p>
                <p class="info-value">
                  {contactInfo.phone}
                </p>
              </div>
            </a>

            <!-- <div class="info-item">
              <svg class="info-icon location-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/>
              </svg>
              <div class="info-content">
                <p class="info-label">Address</p>
                <a href="https://maps.app.goo.gl/yjzQpJaazHZh9Ky68" target="_blank" rel="noopener noreferrer" class="info-value">
                  {contactInfo.address}
                </a>
              </div>
            </div> -->
          </div>

          <!-- Article Submission -->
          <div class="article-submission-card">
            <h3 class="info-title">Submit Your Article</h3>
            <p class="article-description">
              Have an article you'd like to share with us? Send it over to us!
            </p>

            <div class="submission-methods">
              <a href={`mailto:${contactInfo.email}`} class="submission-method">
                <svg
                  class="submission-icon email-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  width="24"
                  height="24"
                >
                  <path
                    d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
                  ></path>
                </svg>
                <div class="submission-info">
                  <p class="submission-label">Email</p>
                  <p class="submission-value">{contactInfo.email}</p>
                </div>
              </a>

              <a
                href="https://wa.me/918208907893"
                target="_blank"
                rel="noopener noreferrer"
                class="submission-method"
              >
                <svg
                  class="submission-icon whatsapp-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  width="24"
                  height="24"
                >
                  <path
                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                  ></path>
                </svg>
                <div class="submission-info">
                  <p class="submission-label">WhatsApp</p>
                  <p class="submission-value">{contactInfo.phone}</p>
                </div>
              </a>
            </div>

            <p class="submission-note-compact">
              Include your name, article title, A single sentance description,
              content, and images.
            </p>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--bg-page);
    font-family: var(--font-body);   /* inherits per-language font from global.css */
  }

  /* ── HERO SECTION ──────────────────────────────────── */
  .hero {
    background: linear-gradient(135deg, #003049 0%, #1e293b 100%);
    color: white;
    padding: 60px 32px 40px;
    text-align: center;
    margin-top: var(--navbar-height);
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      radial-gradient(
        circle at 20% 50%,
        rgba(214, 40, 40, 0.1) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 80% 80%,
        rgba(247, 127, 0, 0.1) 0%,
        transparent 50%
      );
    pointer-events: none;
  }

  .hero-content {
    max-width: 500px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-title {
    font-size: 38px;
    font-weight: 700;
    margin-bottom: 16px;
    letter-spacing: -0.5px;
  }

  .hero-subtitle {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
  }

  /* ── CONTACT SECTION ───────────────────────────────── */
  .contact-section {
    padding: 60px 32px;
    background: #f1f5f9;
  }

  .contact-container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  /* ── CONTACT FORM ──────────────────────────────────── */
  .contact-form-wrapper {
    background: white;
    padding: 40px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .form-header {
    margin-bottom: 32px;
  }

  .form-title {
    font-size: 28px;
    font-weight: 700;
    color: #003049;
    margin-bottom: 8px;
  }

  .form-subtitle {
    font-size: 14px;
    color: #64748b;
  }

  .form-group {
    margin-bottom: 24px;
  }

  .form-label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 8px;
  }

  .form-input,
  .form-textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    font-family: inherit;
    font-size: 14px;
    color: #1e293b;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .form-input:focus,
  .form-textarea:focus {
    outline: none;
    border-color: #d62828;
    box-shadow: 0 0 0 3px rgba(214, 40, 40, 0.1);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .btn-submit {
    width: 100%;
    padding: 14px 24px;
    background: #d62828;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition:
      background 0.2s ease,
      transform 0.1s ease;
  }

  .btn-submit:hover {
    background: #b01f1f;
  }

  .btn-submit:active {
    transform: scale(0.98);
  }

  /* ── CONTACT INFO ──────────────────────────────────── */
  .contact-info-wrapper {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .info-card {
    background: white;
    padding: 32px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .info-title {
    font-size: 23px;
    font-weight: 700;
    color: #003049;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
    padding: 18px;
    background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
    border-radius: 8px;
    transition: all 0.3s ease;
    text-decoration: none;
    cursor: pointer;
  }

  .info-item:hover {
    background: linear-gradient(135deg, #eef2ff 0%, #dbeafe 100%);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0, 48, 73, 0.1);
  }

  .info-item:last-child {
    margin-bottom: 0;
  }

  .info-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    color: #003049;
  }

  .info-icon.email-icon {
    color: #d62828;
  }

  .info-icon.phone-icon {
    color: #0ea5e9;
  }

  .info-icon.location-icon {
    color: #f77f00;
  }

  .info-icon.support-icon {
    color: #8b5cf6;
  }

  .info-content {
    flex: 1;
  }

  .info-label {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }

  .info-value {
    font-size: 15px;
    font-weight: 500;
    color: #1e293b;
    line-height: 1.5;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .info-value:hover {
    color: #d62828;
  }

  /* ── ARTICLE SUBMISSION CARD ──────────────────────────────────── */
  .article-submission-card {
    background: white;
    padding: 32px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .article-description {
    font-size: 14px;
    color: #64748b;
    margin-bottom: 24px;
  }

  .submission-methods {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 20px;
  }

  .submission-method {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    background: #f8fafc;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
    border-left: 3px solid transparent;
  }

  .submission-method:hover {
    background: #f1f5f9;
    border-left-color: #d62828;
  }

  .submission-icon {
    display: block;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    color: #003049;
  }

  .submission-icon.email-icon {
    color: #d62828;
  }

  .submission-icon.whatsapp-icon {
    color: #25d366;
  }

  .submission-info {
    flex: 1;
  }

  .submission-label {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }

  .submission-value {
    font-size: 15px;
    color: #003049;
    font-weight: 500;
  }

  .submission-note-compact {
    font-size: 12px;
    color: #94a3b8;
    line-height: 1.5;
  }

  /* ──────────────────────────────────────────────────────── */
  /* RESPONSIVE: TABLET (768px and below) */
  /* ──────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .hero {
      padding: 80px 24px 60px;
    }

    .hero-title {
      font-size: 36px;
    }

    .hero-subtitle {
      font-size: 16px;
    }

    .contact-section {
      padding: 40px 24px;
    }

    .contact-container {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .contact-info-wrapper {
      order: -1;
    }

    .contact-form-wrapper {
      padding: 32px;
    }

    .form-title {
      font-size: 24px;
    }

    .article-submission-card {
      padding: 24px;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: 60px 16px 40px;
    }

    .hero-title {
      font-size: 28px;
    }

    .hero-subtitle {
      font-size: 14px;
    }

    .contact-section {
      padding: 32px 16px;
    }

    .contact-form-wrapper,
    .info-card {
      padding: 24px;
    }

    .form-title {
      font-size: 20px;
    }

    .info-item {
      padding: 14px;
      gap: 12px;
    }

    .info-icon {
      width: 24px;
      height: 24px;
    }

    .form-input,
    .form-textarea {
      padding: 10px 12px;
      font-size: 16px; /* Prevents zoom on mobile */
    }

    .info-title {
      font-size: 18px;
    }

    .article-submission-card {
      padding: 20px;
    }

    .submission-method {
      padding: 12px;
      gap: 10px;
    }

    .submission-icon {
      width: 20px;
      height: 20px;
    }

    .submission-value {
      font-size: 13px;
    }
  }
</style>
