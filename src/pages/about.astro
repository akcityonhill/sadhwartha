---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE } from "../consts";

const pageTitle = `About | ${SITE_TITLE}`;
const pageDescription = "Learn about Sadhwartha and meet our office bearers.";

// Office bearers data - easily updatable
const officeBearers = [
  {
    name: "Rev. E. P. Samkutty",
    position: "Patron",
    image: "/images/EPS.jpg",
  },
  {
    name: "Pr. Biju Thankachan",
    position: "Publication Director",
    image: "/images/BT.jpg",
  },
  {
    name: "Pr. Manu K Chacko",
    position: "Chief Editor",
    image: "/images/MKC.jpg",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
  </head>

  <body>
    <Navbar />

    <div class="page-wrap">
      <div class="page-header">
        <div class="page-title">About Sadhwartha</div>
        <div class="page-sub">
          Learn about Sadhwartha and meet the leadership of the publication.
        </div>
      </div>
    </div>

    <!-- ── ABOUT CONTENT ─────────────────────────── -->
    <section class="about-section">
      <div class="section-wrap">
        <div class="about-intro">
          <div class="intro-text">
            <p>
              Established in 1989, Sadhwartha serves as the official voice of
              the Church of God in India, Central West Region. It was launched
              with a vision to keep believers informed and connected through
              regional news.
            </p>
            <p>
              Beyond sharing vital updates, Sadhwartha is dedicated to nurturing
              talent by encouraging and publishing the work of writers both
              within our region and beyond.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── OFFICE BEARERS ────────────────────────── -->
    <section class="office-bearers">
      <div class="section-wrap">
        <h2 class="section-heading">Leadership of Sadhwartha Publication</h2>
        <!-- <p class="bearers-subtitle">Leadership of Sadhwartha Publication</p> -->

        <div class="bearers-grid">
          {
            officeBearers.map((bearer) => (
              <div class="bearer-card">
                <div class="bearer-image-wrap">
                  <img
                    src={bearer.image}
                    alt={bearer.name}
                    class="bearer-image"
                  />
                </div>
                <div class="bearer-info">
                  <h3 class="bearer-name">{bearer.name}</h3>
                  <p class="bearer-position">{bearer.position}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── FOOTER ────────────────────────────────── -->
    <Footer />
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--bg-page);
    font-family: var(
      --font-body
    ); /* inherits per-language font from global.css */
  }

  /* ── HEADER ────────────────────────────────── */
  .page-wrap {
    padding: 0 16px;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }

  .page-header {
    background: var(--text-primary);
    border-radius: 12px;
    padding: 28px 32px;
    margin: 6rem 0 1.5rem;
  }

  .page-title {
    font-size: 26px;
    font-weight: 700;
    color: var(--red);
    margin-bottom: 4px;
  }

  .page-sub {
    font-size: 13px;
    color: var(--text-muted);
  }

  /* ── ABOUT SECTION ─────────────────────────────── */
  .about-section {
    padding: 20px 32px 20px;
    margin-top: 0;
  }

  .section-wrap {
    padding: 0 16px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .section-heading {
    font-size: 24px;
    font-weight: 700;
    color: var(--red);
    margin-bottom: 8px;
    text-align: center;
    display: block;
    width: 100%;
  }

  .about-intro {
    line-height: 1.6;
    margin-bottom: 0;
  }

  .intro-text {
    font-size: 16px;
    color: var(--text-dark);
    font-weight: 500;
  }

  .intro-text p {
    margin-bottom: 12px;
    text-align: justify;
    line-height: 1.7;
  }

  .intro-text p:last-child {
    margin-bottom: 0;
  }

  /* ── OFFICE BEARERS ────────────────────────────── */
  .office-bearers {
    padding: 0px 32px 16px;
  }

  .bearers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: 20px;
    margin: 16px auto 0;
    max-width: 500px;
  }

  .bearer-card {
    background: var(--bg-white);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: all 0.3s ease;
    border: 1px solid var(--border);
  }

  .bearer-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    border-color: var(--red);
  }

  .bearer-image-wrap {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: linear-gradient(135deg, var(--bg-page), var(--border));
  }

  .bearer-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bearer-info {
    padding: 8px 6px;
    text-align: center;
  }

  .bearer-name {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .bearer-position {
    font-size: 10px;
    color: var(--red);
    font-weight: 500;
    letter-spacing: 0.03em;
  }

    @media (max-width: 992px) {
    .page-header {
      padding: 20px 16px;
      margin: 4.5rem 0 1.5rem;
    }
  }

  /* ── MOBILE ────────────────────────────────────── */
  @media (max-width: 768px) {
    .page-wrap {
      max-width: 100%;
      padding: 1rem 1rem;
    }

    .page-header {
      padding: 20px 16px;
      margin: 3.2rem 0 1.5rem;
    }

    .page-title {
      font-size: 22px;
    }

    .page-sub {
      font-size: 13px;
    }
    .about-section,
    .office-bearers {
      padding: 16px 20px;
    }

    .section-heading {
      font-size: 24px;
      margin-bottom: 16px;
    }

    .intro-text {
      font-size: 15px;
    }

    .intro-text p {
      text-align: left;
    }

    .bearers-grid {
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 20px;
    }

    .bearer-info {
      padding: 16px;
    }

    .bearer-name {
      font-size: 16px;
    }

    .bearer-position {
      font-size: 12px;
    }
  }

  @media (max-width: 480px) {
    .page-wrap {
      max-width: 100%;
      padding: 0rem 1rem;
    }

    .page-header {
      padding: 20px;
      margin: 4rem 0 1.5rem;
    }
    .bearers-grid {
      grid-template-columns: 1fr;
      max-width: 200px;
    }
  }
</style>
