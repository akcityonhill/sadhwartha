---
import BaseHead from "../../components/BaseHead.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import NewsByLanguageSidebar from "../../components/NewsByLanguageSidebar.astro";
import ArticlesByLanguageSidebar from "../../components/ArticlesByLanguageSidebar.astro";
import { SITE_TITLE } from "../../consts";
import { type CollectionEntry, getCollection } from "astro:content";

const allNews: CollectionEntry<"news">[] = await getCollection("news");
const allArticles = await getCollection("blog");

const sorted = allNews.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const LANGUAGES: Record<string, { label: string; nativeLabel: string }> = {
  en: { label: "English", nativeLabel: "English" },
  ml: { label: "Malayalam", nativeLabel: "മലയാളം" },
  hi: { label: "Hindi", nativeLabel: "हिंदी" },
};

const grouped = sorted.reduce(
  (acc, article) => {
    const lang = article.data.language;
    if (!acc[lang]) acc[lang] = [];
    acc[lang].push(article);
    return acc;
  },
  {} as Record<string, CollectionEntry<"news">[]>,
);

const langOrder = ["en", "ml", "hi"];
const activeLangs = langOrder.filter((l) => grouped[l]?.length > 0);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`News | ${SITE_TITLE}`}
      description="All Sadhwartha news"
    />
  </head>
  <body>
    <Navbar />

    <div class="page-wrap">
      <div class="page-header">
        <div class="page-title">News</div>
        <div class="page-sub">Updates in English, Malayalam and Hindi</div>
      </div>
      <div class="news-layout">
        <!-- LEFT SIDEBAR: news index on desktop,
             accordion on tablet & mobile -->
        <div class="news-sidebar">
          <div class="sidebar-desktop">
            <NewsByLanguageSidebar newsItems={allNews} title="All News" />
          </div>
          <div class="sidebar-accordion">
            <NewsByLanguageSidebar
              newsItems={allNews}
              title="All News"
              collapsible={true}
              defaultOpen={true}
            />
          </div>
        </div>

        <!-- MAIN CONTENT -->
        <div class="news-main">
          <div class="lang-tabs">
            {
              activeLangs.map((lang, i) => (
                <a
                  href={`#lang-${lang}`}
                  class={`lang-tab ${i === 0 ? "active" : ""}`}
                >
                  <span class="tab-native">{LANGUAGES[lang].nativeLabel}</span>
                  <span class="tab-count">{grouped[lang].length}</span>
                </a>
              ))
            }
          </div>

          {
            activeLangs.map((lang) => (
              <div class="lang-section" id={`lang-${lang}`}>
                <div class="lang-header">
                  <span class="lang-native">{LANGUAGES[lang].nativeLabel}</span>
                  {lang !== "en" && (
                    <span class="lang-english">{LANGUAGES[lang].label}</span>
                  )}
                </div>
                <div class="articles-list">
                  {grouped[lang].map((article) => {
                    const enSlug = article.data.translations?.en;
                    const enUrl = enSlug ? `/news/en/${enSlug}` : null;
                    return (
                      <div class="article-card">
                        <a href={`/news/${article.id}`} class="article-link">
                          {article.data.heroImage && (
                            <img
                              src={article.data.heroImage.src}
                              alt={article.data.title}
                              class="article-thumb"
                            />
                          )}
                          <div class="article-body">
                            <span class="article-date">
                              {new Date(
                                article.data.pubDate,
                              ).toLocaleDateString("en-IN", {
                                day: "numeric",
                                month: "long",
                                year: "numeric",
                              })}
                            </span>
                            <div class="article-title">
                              {article.data.title}
                            </div>
                            <div class="article-desc">
                              {article.data.description}
                            </div>
                          </div>
                        </a>
                        {lang !== "en" && enUrl && (
                          <div class="en-version-bar">
                            <a href={enUrl} class="en-version-link">
                              View English version →
                            </a>
                          </div>
                        )}
                      </div>
                    );
                  })}
                </div>
              </div>
            ))
          }
        </div>

        <!-- RIGHT SIDEBAR: articles on desktop,
             accordion on tablet & mobile -->
        <div class="news-sidebar-right">
          <div class="sidebar-desktop">
            <ArticlesByLanguageSidebar
              articles={allArticles}
              title="Articles"
            />
          </div>
          <div class="sidebar-accordion">
            <ArticlesByLanguageSidebar
              articles={allArticles}
              title="Articles"
              collapsible={true}
            />
          </div>
        </div>
      </div>
    </div>

    <Footer />
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    background: var(--bg-page);
    font-family: var(--font-body);
    margin: 0;
    padding-top: var(--navbar-height);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .page-wrap {
    flex: 1;
    padding: 0 16px;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }

  /* ── DESKTOP: 3 columns ──────────────────────── */
  .news-layout {
    display: grid;
    grid-template-columns: 260px 1fr 260px;
    gap: 24px;
    align-items: start;
  }

  .news-sidebar {
    order: 1;
    margin-top: 2rem;
  }
  .news-main {
    order: 2;
    min-width: 0;
  }
  .news-sidebar-right {
    order: 3;
    margin-top: 2rem;
  }

  /* show panel, hide accordion on desktop */
  .sidebar-accordion {
    display: none;
  }
  .sidebar-desktop {
    display: block;
  }

  /* ── PAGE HEADER ─────────────────────────────── */
  .page-header {
    background: var(--text-primary);
    border-radius: 12px;
    padding: 28px 32px;
    margin: 2rem 0 1.5rem;
  }
  .page-title {
    font-size: 26px;
    font-weight: 700;
    color: var(--red);
    margin-bottom: 4px;
  }
  .page-sub {
    font-size: 13px;
    color: var(--text-muted);
  }

  /* ── LANGUAGE TABS ───────────────────────────── */
  .lang-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .lang-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    border-radius: 20px;
    border: 1.5px solid var(--border);
    background: var(--bg-white);
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 13px;
    transition: all 0.15s;
  }
  .lang-tab:hover,
  .lang-tab.active {
    border-color: var(--red);
    background: #fffbf0;
    color: var(--red);
  }

  .tab-count {
    font-size: 11px;
    background: var(--bg-page);
    color: var(--text-muted);
    padding: 1px 6px;
    border-radius: 10px;
  }

  /* ── LANGUAGE SECTIONS ───────────────────────── */
  .lang-section {
    margin-bottom: 2.5rem;
  }

  .lang-header {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding-bottom: 10px;
    margin-bottom: 16px;
    border-bottom: 2px solid var(--red);
  }
  .lang-native {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
  }
  .lang-english {
    font-size: 12px;
    color: var(--text-muted);
  }

  /* ── ARTICLE CARDS ───────────────────────────── */
  .articles-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .article-card {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    transition: box-shadow 0.15s;
  }
  .article-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);
  }

  .article-link {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    text-decoration: none;
    color: inherit;
  }

  .article-thumb {
    width: 120px;
    height: 90px;
    object-fit: cover;
    border-radius: 8px;
    flex-shrink: 0;
    background: var(--bg-page);
  }

  .article-body {
    flex: 1;
  }

  .article-date {
    display: block;
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .article-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
    line-height: 1.35;
  }
  .article-card:hover .article-title {
    color: var(--red);
  }

  .article-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .en-version-bar {
    border-top: 1px solid var(--border-light);
    padding: 8px 16px;
    background: #fffbf0;
  }
  .en-version-link {
    font-size: 12px;
    color: var(--red);
    text-decoration: none;
    font-weight: 500;
  }
  .en-version-link:hover {
    text-decoration: underline;
  }

  /* ── TABLET: left sidebar stays, right drops below main ── */
  @media (max-width: 1024px) {
    .news-layout {
      grid-template-columns: 220px 1fr; /* slightly narrower sidebar */
      grid-template-rows: auto auto;
      gap: 16px;
    }
    .news-sidebar {
      grid-column: 1;
      grid-row: 1 / 3;
      margin-top: 2rem;
    }
    .news-main {
      grid-column: 2;
      grid-row: 1;
    }
    .news-sidebar-right {
      grid-column: 2;
      grid-row: 2;
      margin-top: 0;
    }
    .sidebar-desktop {
      display: none;
    }
    .sidebar-accordion {
      display: block;
    }
  }

  /* ── MOBILE: single column, all accordions ───── */
  @media (max-width: 680px) {
    .news-layout {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 12px;
    }

    .news-main {
      order: 1;
    }
    .news-sidebar {
      order: 2;
      margin-top: 0;
    }
    .news-sidebar-right {
      order: 3;
      margin-top: 0;
    }

    .sidebar-desktop {
      display: none;
    }
    .sidebar-accordion {
      display: block;
    }

    .page-wrap {
      padding: 0 12px;
    }
    .page-header {
      padding: 20px;
      margin: 1rem 0;
    }
    .article-link {
      gap: 12px;
    }
    .article-thumb {
      width: 90px;
      height: 68px;
    }
  }

  @media (max-width: 480px) {
    body {
      padding-top: 45px;
    }
  }
</style>
