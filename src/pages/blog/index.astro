---
import BaseHead from '../../components/BaseHead.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('blog');

const sorted = allArticles.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Language display config
const LANGUAGES: Record<string, { label: string; nativeLabel: string }> = {
  en: { label: 'English',   nativeLabel: 'English'   },
  ml: { label: 'Malayalam', nativeLabel: 'മലയാളം'   },
  hi: { label: 'Hindi',     nativeLabel: 'हिंदी'      },
};

// Group by language
const grouped = sorted.reduce((acc, article) => {
  const lang = article.data.language;
  if (!acc[lang]) acc[lang] = [];
  acc[lang].push(article);
  return acc;
}, {} as Record<string, typeof sorted>);

const langOrder = ['en', 'ml', 'hi'];
const activeLangs = langOrder.filter((l) => grouped[l]?.length > 0);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Articles | ${SITE_TITLE}`} description="All Sadhwartha articles" />
  </head>
  <body>

    <nav class="navbar">
      <a href="/" class="nav-brand">
        <span class="brand-ml">സാദ്ധ്വർത്ഥ</span>
        <span class="brand-en">SADHWARTHA</span>
      </a>
      <div class="nav-links">
        <a href="/"       class="nav-link">Home</a>
        <a href="/blog"   class="nav-link active">Articles</a>
        <a href="/news"   class="nav-link">News</a>
        <a href="/about"  class="nav-link">About</a>
        <a href="/contact" class="nav-link">Contact</a>
      </div>
    </nav>

    <div class="page-wrap">

      <div class="page-header">
        <div class="page-title">Articles</div>
        <div class="page-sub">Publications in English, Malayalam and Hindi</div>
      </div>

      <!-- Language tabs -->
      <div class="lang-tabs">
        {activeLangs.map((lang, i) => (
          <a href={`#lang-${lang}`} class={`lang-tab ${i === 0 ? 'active' : ''}`}>
            <span class="tab-native">{LANGUAGES[lang].nativeLabel}</span>
            <span class="tab-count">{grouped[lang].length}</span>
          </a>
        ))}
      </div>

      <!-- Articles grouped by language -->
      {activeLangs.map((lang) => (
        <div class="lang-section" id={`lang-${lang}`}>

          <div class="lang-header">
            <span class="lang-native">{LANGUAGES[lang].nativeLabel}</span>
            {lang !== 'en' && (
              <span class="lang-english">{LANGUAGES[lang].label}</span>
            )}
          </div>

          <div class="articles-list">
            {grouped[lang].map((article) => {
              // Build the English version URL if translation slug is provided
              const enSlug = article.data.translations?.en;
              const enUrl  = enSlug ? `/blog/en/${enSlug}` : null;

              return (
                <div class="article-card">
                  <a href={`/blog/${article.id}`} class="article-link">
                    {article.data.heroImage && (
                      <img
                        src={article.data.heroImage.src}
                        alt={article.data.title}
                        class="article-thumb"
                      />
                    )}
                    <div class="article-body">
                      <span class="article-date">
                        {new Date(article.data.pubDate).toLocaleDateString('en-IN', {
                          day: 'numeric', month: 'long', year: 'numeric',
                        })}
                      </span>
                      <div class="article-title">{article.data.title}</div>
                      <div class="article-desc">{article.data.description}</div>
                    </div>
                  </a>
                  {lang !== 'en' && enUrl && (
                    <div class="en-version-bar">
                      <a href={enUrl} class="en-version-link">
                        View English version →
                      </a>
                    </div>
                  )}
                </div>
              );
            })}
          </div>

        </div>
      ))}

    </div>

    <footer class="footer">
      <div>
        <div class="footer-brand">SADHWARTHA</div>
        <div class="footer-sub">Church of God (Full Gospel) in India, Central West Region</div>
      </div>
      <div class="footer-links">
        <a href="/blog"    class="footer-link">Articles</a>
        <a href="/news"    class="footer-link">News</a>
        <a href="/contact" class="footer-link">Contact</a>
      </div>
    </footer>

  </body>
</html>

<style>
  * { box-sizing: border-box; }

  body {
    background: #f1f5f9;
    font-family: system-ui, -apple-system, sans-serif;
    margin: 0;
    padding: 0 1rem;
  }

  /* ── NAVBAR ─────────────────────────────────── */
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 24px;
    background: #fffbf0;
    border-bottom: 2px solid #f59e0b;
    max-width: 1100px;
    margin: 0 auto 1.5rem;
    border-radius: 0 0 12px 12px;
  }

  .nav-brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1.25;
  }

  .brand-ml {
    font-size: 18px;
    font-weight: 700;
    color: #1e293b;
  }

  .brand-en {
    font-size: 10px;
    font-weight: 600;
    color: #92400e;
    letter-spacing: 0.14em;
  }

  .nav-links { display: flex; gap: 20px; }

  .nav-link {
    font-size: 13px;
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s;
  }

  .nav-link:hover, .nav-link.active {
    color: #d97706;
    font-weight: 500;
  }

  /* ── PAGE ────────────────────────────────────── */
  .page-wrap {
    max-width: 760px;
    margin: 0 auto 3rem;
  }

  .page-header {
    background: #1e293b;
    border-radius: 12px;
    padding: 28px 32px;
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-size: 26px;
    font-weight: 700;
    color: #f59e0b;
    margin-bottom: 4px;
  }

  .page-sub {
    font-size: 13px;
    color: #94a3b8;
  }

  /* ── LANGUAGE TABS ───────────────────────────── */
  .lang-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .lang-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    border-radius: 20px;
    border: 1.5px solid #e2e8f0;
    background: #fff;
    text-decoration: none;
    color: #475569;
    font-size: 13px;
    transition: all 0.15s;
  }

  .lang-tab:hover, .lang-tab.active {
    border-color: #f59e0b;
    background: #fffbf0;
    color: #92400e;
  }

  .tab-count {
    font-size: 11px;
    background: #f1f5f9;
    color: #94a3b8;
    padding: 1px 6px;
    border-radius: 10px;
  }

  /* ── LANGUAGE SECTION ────────────────────────── */
  .lang-section {
    margin-bottom: 2.5rem;
  }

  .lang-header {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding-bottom: 10px;
    margin-bottom: 16px;
    border-bottom: 2px solid #f59e0b;
  }

  .lang-native {
    font-size: 20px;
    font-weight: 700;
    color: #1e293b;
  }

  .lang-english {
    font-size: 12px;
    color: #94a3b8;
  }

  /* ── ARTICLE CARDS ───────────────────────────── */
  .articles-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .article-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    transition: box-shadow 0.15s;
  }

  .article-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.07);
  }

  .article-link {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    text-decoration: none;
    color: inherit;
  }

  .article-thumb {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 8px;
    flex-shrink: 0;
    background: #f1f5f9;
  }

  .article-body { flex: 1; }

  .article-date {
    display: block;
    font-size: 11px;
    color: #94a3b8;
    margin-bottom: 4px;
  }

  .article-title {
    font-size: 15px;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 4px;
    line-height: 1.35;
  }

  .article-card:hover .article-title { color: #d97706; }

  .article-desc {
    font-size: 13px;
    color: #64748b;
    line-height: 1.5;
  }

  /* ── ENGLISH VERSION LINK ────────────────────── */
  .en-version-bar {
    border-top: 1px solid #f1f5f9;
    padding: 8px 16px;
    background: #fffbf0;
  }

  .en-version-link {
    font-size: 12px;
    color: #d97706;
    text-decoration: none;
    font-weight: 500;
  }

  .en-version-link:hover { text-decoration: underline; }

  /* ── FOOTER ──────────────────────────────────── */
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #1e293b;
    border-radius: 12px;
    padding: 16px 24px;
    max-width: 1100px;
    margin: 0 auto 1.5rem;
  }

  .footer-brand {
    font-size: 13px;
    font-weight: 600;
    color: #f59e0b;
    letter-spacing: 0.08em;
  }

  .footer-sub {
    font-size: 11px;
    color: #64748b;
    margin-top: 2px;
  }

  .footer-links { display: flex; gap: 16px; }

  .footer-link {
    font-size: 11px;
    color: #64748b;
    text-decoration: none;
  }

  .footer-link:hover { color: #f59e0b; }

  /* ── MOBILE ──────────────────────────────────── */
  @media (max-width: 640px) {
    .navbar { padding: 12px 16px; }
    .nav-links { gap: 12px; flex-wrap: wrap; }
    .page-header { padding: 20px; }
    .article-link { gap: 12px; }
    .footer { flex-direction: column; gap: 12px; text-align: center; }
  }
</style>
