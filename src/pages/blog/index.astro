---
import BaseHead from "../../components/BaseHead.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ArticlesByLanguageSidebar from "../../components/ArticlesByLanguageSidebar.astro";
import NewsByLanguageSidebar from "../../components/NewsByLanguageSidebar.astro";
import { SITE_TITLE, SITE_OG_LOGO } from "../../consts";
import { getCollection } from "astro:content";

const allArticles = await getCollection("blog");
const allNews = await getCollection("news");

const sorted = allArticles.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const LANGUAGES: Record<string, { label: string; nativeLabel: string }> = {
  en: { label: "English", nativeLabel: "English" },
  ml: { label: "Malayalam", nativeLabel: "മലയാളം" },
  hi: { label: "Hindi", nativeLabel: "हिंदी" },
};

const grouped = sorted.reduce(
  (acc, article) => {
    const lang = article.data.language;
    if (!acc[lang]) acc[lang] = [];
    acc[lang].push(article);
    return acc;
  },
  {} as Record<string, typeof sorted>,
);

const langOrder = ["en", "ml", "hi"];
const activeLangs = langOrder.filter((l) => grouped[l]?.length > 0);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Articles | ${SITE_TITLE}`}
      description="All Sadhwartha articles"
      image={SITE_OG_LOGO}
    />
  </head>
  <body>
    <Navbar />

    <div class="page-wrap">
      <div class="page-header">
        <div class="page-title">Articles</div>
        <div class="page-sub">Publications in English, Malayalam and Hindi</div>
      </div>
      <div class="blog-layout">
        <!-- LEFT SIDEBAR: always visible panel on desktop,
             accordion on tablet & mobile -->
        <div class="blog-sidebar">
          <div class="sidebar-desktop">
            <ArticlesByLanguageSidebar
              articles={allArticles}
              title="All Articles"
            />
          </div>
          <div class="sidebar-accordion">
            <ArticlesByLanguageSidebar
              articles={allArticles}
              title="All Articles"
              collapsible={true}
            />
          </div>
        </div>

        <!-- MAIN CONTENT -->
        <div class="blog-main">
          <div class="lang-tabs">
            <span class="lang-tab-pill" aria-hidden="true"></span>
            {
              activeLangs.map((lang, i) => (
                <a
                  href={`#lang-${lang}`}
                  class={`lang-tab ${i === 0 ? "active" : ""}`}
                  data-lang={lang}
                >
                  <span class="tab-native">{LANGUAGES[lang].nativeLabel}</span>
                  <span class="tab-count">{grouped[lang].length}</span>
                </a>
              ))
            }
          </div>

          {
            activeLangs.map((lang) => (
              <div class="lang-section" id={`lang-${lang}`}>
                <div class="lang-header">
                  <span class="lang-native">{LANGUAGES[lang].nativeLabel}</span>
                  {lang !== "en" && (
                    <span class="lang-english">{LANGUAGES[lang].label}</span>
                  )}
                </div>
                <div class="articles-list">
                  {grouped[lang].map((article) => {
                    const enSlug = article.data.translations?.en;
                    const enUrl = enSlug ? `/blog/en/${enSlug}` : null;
                    return (
                      <div class="article-card">
                        <a href={`/blog/${article.id}`} class="article-link">
                          {article.data.heroImage && (
                            <img
                              src={article.data.heroImage.src}
                              alt={article.data.title}
                              class="article-thumb"
                            />
                          )}
                          <div class="article-body">
                            <span class="article-date">
                              {new Date(
                                article.data.pubDate,
                              ).toLocaleDateString("en-IN", {
                                day: "numeric",
                                month: "long",
                                year: "numeric",
                              })}
                            </span>
                            <div class="article-title">
                              {article.data.title}
                            </div>
                            <div class="article-desc">
                              {article.data.description}
                            </div>
                          </div>
                        </a>
                        {lang !== "en" && enUrl && (
                          <div class="en-version-bar">
                            <a href={enUrl} class="en-version-link">
                              View English version →
                            </a>
                          </div>
                        )}
                      </div>
                    );
                  })}
                </div>
              </div>
            ))
          }
        </div>

        <!-- RIGHT SIDEBAR: always visible panel on desktop,
             accordion on tablet & mobile -->
        <div class="blog-sidebar-right">
          <div class="sidebar-desktop">
            <NewsByLanguageSidebar newsItems={allNews} title="News" />
          </div>
          <div class="sidebar-accordion">
            <NewsByLanguageSidebar
              newsItems={allNews}
              title="News"
              collapsible={true}
            />
          </div>
        </div>
      </div>
    </div>

    <Footer />
  </body>
</html>

<script>
  // Sliding pill for the language segmented control
  function initLangTabPill(): void {
    const container = document.querySelector(".lang-tabs") as HTMLElement | null;
    const pill = container?.querySelector(".lang-tab-pill") as HTMLElement | null;
    const tabs = Array.from(
      container?.querySelectorAll<HTMLAnchorElement>(".lang-tab") ?? [],
    );

    if (!container || !pill || tabs.length === 0) return;

    function movePillTo(tab: HTMLElement): void {
      const containerRect = container!.getBoundingClientRect();
      const tabRect = tab.getBoundingClientRect();
      pill!.style.width = `${tabRect.width}px`;
      pill!.style.left = `${tabRect.left - containerRect.left}px`;
      pill!.style.opacity = "1";
    }

    function setActive(tab: HTMLElement): void {
      tabs.forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");
      movePillTo(tab);
    }

    // Honor a #lang-xx hash on load, falling back to the server-rendered default
    const hashLang = window.location.hash.replace("#lang-", "");
    const initial =
      tabs.find((t) => t.dataset.lang === hashLang) ??
      tabs.find((t) => t.classList.contains("active")) ??
      tabs[0];

    requestAnimationFrame(() => setActive(initial));

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => setActive(tab));
    });

    let resizeTimer: number;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        const current = tabs.find((t) => t.classList.contains("active"));
        if (current) movePillTo(current);
      }, 100);
    });
  }

  initLangTabPill();
</script>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    background: var(--bg-page);
    font-family: var(--font-body);
    margin: 0;
    padding-top: var(--navbar-height);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .page-wrap {
    flex: 1;
    padding: 0 16px;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }

  /* ── DESKTOP: 3 columns ──────────────────────── */
  .blog-layout {
    display: grid;
    grid-template-columns: 260px 1fr 260px;
    gap: 24px;
    align-items: start;
  }

  .blog-sidebar {
    order: 1;
  }
  .blog-main {
    order: 2;
    min-width: 0;
  }
  .blog-sidebar-right {
    order: 3;
  }

  /* show panel, hide accordion on desktop */
  .sidebar-accordion {
    display: none;
  }
  .sidebar-desktop {
    display: block;
  }

  /* ── PAGE HEADER ─────────────────────────────── */
  .page-header {
    background: var(--text-primary);
    border-radius: 12px;
    padding: 28px 32px;
    margin: 2rem 0 2rem; /* bottom gap matches homepage's banner→sidebar gap */
  }
  .page-title {
    font-size: 26px;
    font-weight: 700;
    color: var(--red);
    margin-bottom: 4px;
  }
  .page-sub {
    font-size: 13px;
    color: var(--text-muted);
  }

  /* ── LANGUAGE TABS ───────────────────────────── */
  .lang-tabs {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
    margin-bottom: 1.5rem; /* was 2rem */
    margin-top: 0;
    flex-wrap: wrap;
    width: fit-content;
    padding: 4px;
    background: var(--bg-page);
    border: 1px solid var(--border);
    border-radius: 24px;
  }

  .lang-tab-pill {
    position: absolute;
    top: 4px;
    left: 4px;
    height: 34px;
    width: 0;
    border-radius: 20px;
    background: #fffbf0;
    border: 1.5px solid var(--red);
    box-shadow: 0 1px 3px rgba(214, 40, 40, 0.12);
    opacity: 0;
    transition:
      left 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      width 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease;
  }

  .lang-tab {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    height: 34px;
    gap: 6px;
    padding: 0 16px;
    border-radius: 20px;
    border: none;
    background: transparent;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1;
    transition: color 0.2s;
  }
  .lang-tab:hover {
    color: var(--red);
  }
  .lang-tab.active {
    color: var(--red);
  }

  .tab-native {
    display: inline-block;
    line-height: 1;
  }

  .tab-count {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    font-size: 11px;
    background: rgba(15, 23, 42, 0.06);
    color: var(--text-muted);
    padding: 3px 6px;
    border-radius: 10px;
    transition: background 0.2s;
  }
  .lang-tab.active .tab-count {
    background: var(--bg-white);
    color: var(--red);
  }

  /* ── LANGUAGE SECTIONS ───────────────────────── */
  .lang-section {
    margin-bottom: 2.5rem;
  }

  .lang-header {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding-bottom: 10px;
    margin-bottom: 16px;
    border-bottom: 2px solid var(--red);
  }
  .lang-native {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
  }
  .lang-english {
    font-size: 12px;
    color: var(--text-muted);
  }

  /* ── ARTICLE CARDS ───────────────────────────── */
  .articles-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .article-card {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    transition: box-shadow 0.15s;
  }
  .article-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);
  }

  .article-link {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    text-decoration: none;
    color: inherit;
  }

  .article-thumb {
    width: 120px;
    height: 90px;
    object-fit: fill;
    border-radius: 8px;
    flex-shrink: 0;
    background: var(--bg-page);
  }

  .article-body {
    flex: 1;
  }

  .article-date {
    display: block;
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .article-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
    line-height: 1.35;
  }
  .article-card:hover .article-title {
    color: var(--red);
  }

  .article-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .en-version-bar {
    border-top: 1px solid var(--border-light);
    padding: 8px 16px;
    background: #fffbf0;
  }
  .en-version-link {
    font-size: 12px;
    color: var(--red);
    text-decoration: none;
    font-weight: 500;
  }
  .en-version-link:hover {
    text-decoration: underline;
  }

  /* ── TABLET: 2 columns, right sidebar becomes accordion below main ── */
  @media (max-width: 1024px) {
    .blog-layout {
      grid-template-columns: 220px 1fr; /* slightly narrower sidebar */
      grid-template-rows: auto auto;
      gap: 16px;
    }
    .blog-sidebar {
      grid-column: 1;
      grid-row: 1 / 3;
    }
    .blog-main {
      grid-column: 2;
      grid-row: 1;
    }
    .blog-sidebar-right {
      grid-column: 2;
      grid-row: 2;
      margin-top: 0;
    }
    .sidebar-desktop {
      display: none;
    }
    .sidebar-accordion {
      display: block;
    }
  }

  /* ── MOBILE: single column, both sidebars as accordions ── */
  @media (max-width: 680px) {
    .blog-layout {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 12px;
    }

    .blog-main {
      order: 1;
    }
    .blog-sidebar {
      order: 2;
      margin-top: 0;
    }
    .blog-sidebar-right {
      order: 3;
      margin-top: 0;
    }

    .sidebar-desktop {
      display: none;
    }
    .sidebar-accordion {
      display: block;
    }

    .page-wrap {
      padding: 0 12px;
    }
    .page-header {
      padding: 20px;
      margin: 1rem 0;
    }
    .article-link {
      gap: 12px;
    }
    .article-thumb {
      width: 90px;
      height: 68px;
    }
  }

  @media (max-width: 480px) {
    body {
      padding-top: 45px;
    }
  }
</style>