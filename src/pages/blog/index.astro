---
import BaseHead from '../../components/BaseHead.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('blog');

const sorted = allArticles.sort((a, b) => 
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const grouped = sorted.reduce((acc, article) => {
  const date = new Date(article.data.pubDate);
  const year = date.getFullYear();
  const month = date.toLocaleDateString('en-IN', { month: 'long' });
  const key = `${year}-${String(date.getMonth() + 1).padStart(2, '0')}`;

  if (!acc[year]) acc[year] = {};
  if (!acc[year][key]) acc[year][key] = { month, articles: [] };
  acc[year][key].articles.push(article);

  return acc;
}, {});

const years = Object.keys(grouped).sort((a, b) => b - a);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Articles | ${SITE_TITLE}`} description="All Sadhwartha articles" />
  </head>
  <body>

    <nav class="navbar">
      <a href="/" class="nav-brand">SADHWARTHA</a>
      <div class="nav-links">
        <a href="/" class="nav-link">Home</a>
        <a href="/blog" class="nav-link active">Articles</a>
        <a href="/archive" class="nav-link">Archive</a>
        <a href="/news" class="nav-link">News</a>
        <a href="/about" class="nav-link">About</a>
        <a href="/contact" class="nav-link">Contact</a>
      </div>
    </nav>

    <div class="page-wrap">

      <div class="page-header">
        <div class="page-title">Articles</div>
        <div class="page-sub">Monthly publications in English, Hindi and Malayalam</div>
      </div>

      <div class="tree-wrap">
        {years.map((year) => (
          <div class="year-group">

            <div class="year-label">
              <span class="year-icon">▸</span>
              {year}
            </div>

            {Object.keys(grouped[year])
              .sort((a, b) => b.localeCompare(a))
              .map((key) => {
                const { month, articles } = grouped[year][key];
                return (
                  <div class="month-group">
                    <div class="month-label">
                      <span class="tree-line">└──</span>
                      <span class="month-name">{month}</span>
                      <span class="article-count">{articles.length} article{articles.length > 1 ? 's' : ''}</span>
                    </div>
                    {articles.map((article) => (
                      <a href={`/blog/${article.slug}`} class="article-row">
                        <span class="tree-indent">
                          <span class="tree-line-indent">└──</span>
                        </span>
                        <span class="article-info">
                          <span class="article-title">{article.data.title}</span>
                          {article.data.language && (
                            <span class="lang-badge">{article.data.language}</span>
                          )}
                        </span>
                      </a>
                    ))}
                  </div>
                );
              })}

          </div>
        ))}
      </div>

    </div>

    <footer class="footer">
      <div>
        <div class="footer-brand">SADHWARTHA</div>
        <div class="footer-sub">Church of God (Full Gospel) in India, Central West Region</div>
      </div>
      <div class="footer-links">
        <a href="/blog" class="footer-link">Articles</a>
        <a href="/archive" class="footer-link">Archive</a>
        <a href="/contact" class="footer-link">Contact</a>
      </div>
    </footer>

  </body>
</html>

<style>
  body {
    background: #f1f5f9;
    font-family: system-ui, -apple-system, sans-serif;
    margin: 0;
    padding: 0 1rem;
  }

  /* NAV */
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
    background: #1e293b;
    border-radius: 12px;
    margin: 1rem auto;
    max-width: 1100px;
  }
  .nav-brand {
    font-size: 16px;
    font-weight: 500;
    color: #f59e0b;
    letter-spacing: 0.1em;
    text-decoration: none;
  }
  .nav-links { display: flex; gap: 20px; }
  .nav-link {
    font-size: 13px;
    color: #94a3b8;
    text-decoration: none;
  }
  .nav-link:hover, .nav-link.active { color: #f59e0b; }

  /* PAGE */
  .page-wrap {
    max-width: 720px;
    margin: 0 auto 2rem;
  }
  .page-header {
    background: #1e293b;
    border-radius: 12px;
    padding: 28px 32px;
    margin-bottom: 1.5rem;
  }
  .page-title {
    font-size: 26px;
    font-weight: 500;
    color: #f59e0b;
    letter-spacing: 0.06em;
    margin-bottom: 6px;
  }
  .page-sub {
    font-size: 13px;
    color: #94a3b8;
  }

  /* TREE */
  .tree-wrap {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .year-group {
    background: #ffffff;
    border: 0.5px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
  }
  .year-label {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #1e293b;
    color: #f59e0b;
    font-size: 15px;
    font-weight: 500;
    padding: 12px 20px;
    letter-spacing: 0.08em;
  }
  .year-icon {
    font-size: 12px;
    opacity: 0.7;
  }
  .month-group {
    border-bottom: 0.5px solid #f1f5f9;
    padding: 4px 0;
  }
  .month-group:last-child { border-bottom: none; }
  .month-label {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: #f8fafc;
  }
  .tree-line {
    font-size: 12px;
    color: #94a3b8;
    font-family: monospace;
  }
  .month-name {
    font-size: 13px;
    font-weight: 500;
    color: #1e293b;
  }
  .article-count {
    font-size: 11px;
    color: #94a3b8;
    margin-left: 4px;
  }
  .article-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 20px 9px 32px;
    text-decoration: none;
    border-bottom: 0.5px solid #f8fafc;
    transition: background 0.15s;
  }
  .article-row:last-child { border-bottom: none; }
  .article-row:hover { background: #fefce8; }
  .tree-line-indent {
    font-size: 12px;
    color: #cbd5e1;
    font-family: monospace;
  }
  .article-info {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
  }
  .article-title {
    font-size: 13px;
    color: #1e293b;
  }
  .article-row:hover .article-title { color: #f59e0b; }
  .lang-badge {
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 20px;
    background: #fef3c7;
    color: #92400e;
    border: 0.5px solid #f59e0b;
    white-space: nowrap;
  }

  /* FOOTER */
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #1e293b;
    border-radius: 12px;
    padding: 16px 24px;
    margin: 0 auto 1rem;
    max-width: 1100px;
  }
  .footer-brand {
    font-size: 13px;
    font-weight: 500;
    color: #f59e0b;
    letter-spacing: 0.08em;
  }
  .footer-sub {
    font-size: 11px;
    color: #64748b;
    margin-top: 2px;
  }
  .footer-links { display: flex; gap: 16px; }
  .footer-link {
    font-size: 11px;
    color: #64748b;
    text-decoration: none;
  }
  .footer-link:hover { color: #f59e0b; }

  /* MOBILE */
  @media (max-width: 768px) {
    .nav-links { gap: 12px; flex-wrap: wrap; }
    .page-header { padding: 20px; }
    .article-row { padding-left: 24px; }
    .footer { flex-direction: column; gap: 12px; text-align: center; }
  }
</style>