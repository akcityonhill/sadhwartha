---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('blog');

// Show latest 4 articles on homepage
const recentArticles = allArticles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const LANG_LABELS: Record<string, string> = {
  en: 'English',
  ml: 'മലയാളം',
  hi: 'हिंदी',
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body>

    <!-- ── NAVBAR ───────────────────────────────── -->
    <nav class="navbar">
      <a href="/" class="nav-brand">
        <span class="brand-ml">സദ്വാർത്ത</span>
        <span class="brand-en">SADHWARTHA</span>
      </a>
      <div class="nav-links">
        <a href="/"        class="nav-link active">Home</a>
        <a href="/blog"    class="nav-link">Articles</a>
        <a href="/news"    class="nav-link">News</a>
        <a href="/about"   class="nav-link">About</a>
        <a href="/contact" class="nav-link">Contact</a>
      </div>
      <button class="nav-toggle" aria-label="Toggle menu" onclick="
        document.querySelector('.nav-links').classList.toggle('open');
      ">☰</button>
    </nav>

    <!-- ── HERO ─────────────────────────────────── -->
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-tag">Church of God (Full Gospel) in India</div>
        <h1 class="hero-title">
          <span class="hero-title-ml">സദ്വാർത്ത</span>
          <span class="hero-title-en">Sadhwartha</span>
        </h1>
        <p class="hero-sub">
          Proclaiming the Gospel across Central West Region —
          in English, Malayalam and Hindi.
        </p>
        <div class="hero-actions">
          <a href="/blog" class="btn-primary">Read Articles</a>
          <a href="/about" class="btn-secondary">About Us</a>
        </div>
      </div>
    </section>

    <!-- ── RECENT ARTICLES ───────────────────────── -->
    <section class="section">
      <div class="section-wrap">

        <div class="section-header">
          <h2 class="section-title">Recent Articles</h2>
          <a href="/blog" class="section-more">View all →</a>
        </div>

        <div class="articles-grid">
          {recentArticles.map((article) => (
            <a href={`/blog/${article.id}`} class="article-card">
              <div class="card-img-wrap">
                {article.data.heroImage
                  ? <img src={article.data.heroImage.src} alt={article.data.title} class="card-img" />
                  : <div class="card-img-placeholder">✝</div>
                }
              </div>
              <div class="card-body">
                <div class="card-meta">
                  <span class="card-lang">{LANG_LABELS[article.data.language] ?? article.data.language}</span>
                  <span class="card-date">
                    {new Date(article.data.pubDate).toLocaleDateString('en-IN', {
                      day: 'numeric', month: 'short', year: 'numeric',
                    })}
                  </span>
                </div>
                <div class="card-title">{article.data.title}</div>
                <div class="card-desc">{article.data.description}</div>
              </div>
            </a>
          ))}
        </div>

      </div>
    </section>

    <!-- ── QUICK LINKS ───────────────────────────── -->
    <section class="quicklinks">
      <div class="section-wrap">
        <div class="ql-grid">
          <a href="/blog?lang=ml" class="ql-card">
            <div class="ql-icon">മ</div>
            <div class="ql-label">മലയാളം</div>
            <div class="ql-sub">Malayalam Articles</div>
          </a>
          <a href="/blog?lang=hi" class="ql-card">
            <div class="ql-icon">हि</div>
            <div class="ql-label">हिंदी</div>
            <div class="ql-sub">Hindi Articles</div>
          </a>
          <a href="/blog?lang=en" class="ql-card">
            <div class="ql-icon">En</div>
            <div class="ql-label">English</div>
            <div class="ql-sub">English Articles</div>
          </a>
          <a href="/contact" class="ql-card">
            <div class="ql-icon">✉</div>
            <div class="ql-label">Contact</div>
            <div class="ql-sub">Get in touch</div>
          </a>
        </div>
      </div>
    </section>

    <!-- ── FOOTER ────────────────────────────────── -->
    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-brand-block">
          <div class="footer-brand-ml">സദ്വാർത്ത</div>
          <div class="footer-brand-en">SADHWARTHA</div>
          <div class="footer-tagline">
            Church of God (Full Gospel) in India<br />Central West Region
          </div>
        </div>
        <div class="footer-links-block">
          <div class="footer-col">
            <div class="footer-col-title">Publication</div>
            <a href="/blog"    class="footer-link">Articles</a>
            <a href="/news"    class="footer-link">News</a>
          </div>
          <div class="footer-col">
            <div class="footer-col-title">Info</div>
            <a href="/about"   class="footer-link">About Us</a>
            <a href="/contact" class="footer-link">Contact</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        © {new Date().getFullYear()} Sadhwartha · Church of God (Full Gospel) in India
      </div>
    </footer>

  </body>
</html>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: #f1f5f9;
    font-family: system-ui, -apple-system, sans-serif;
  }

  /* ── NAVBAR ─────────────────────────────────── */
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 32px;
    background: #fffbf0;
    border-bottom: 2px solid #f59e0b;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1.25;
  }

  .brand-ml { font-size: 20px; font-weight: 700; color: #1e293b; }
  .brand-en { font-size: 10px; font-weight: 600; color: #92400e; letter-spacing: 0.15em; }

  .nav-links { display: flex; gap: 24px; }

  .nav-link {
    font-size: 14px;
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s;
  }

  .nav-link:hover, .nav-link.active {
    color: #d97706;
    font-weight: 500;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: #475569;
  }

  /* ── HERO ────────────────────────────────────── */
  .hero {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 60%, #1c1917 100%);
    padding: 72px 32px;
    text-align: center;
  }

  .hero-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .hero-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    color: #f59e0b;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.25);
    padding: 4px 14px;
    border-radius: 20px;
    margin-bottom: 20px;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-bottom: 16px;
  }

  .hero-title-ml {
    font-size: 48px;
    font-weight: 700;
    color: #fff;
    line-height: 1.1;
  }

  .hero-title-en {
    font-size: 16px;
    font-weight: 500;
    color: #f59e0b;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hero-sub {
    font-size: 15px;
    color: #94a3b8;
    line-height: 1.7;
    margin-bottom: 28px;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    padding: 10px 24px;
    background: #f59e0b;
    color: #1e293b;
    font-weight: 600;
    font-size: 14px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s;
  }

  .btn-primary:hover { background: #d97706; }

  .btn-secondary {
    padding: 10px 24px;
    background: transparent;
    color: #cbd5e1;
    font-weight: 500;
    font-size: 14px;
    border-radius: 8px;
    border: 1px solid #334155;
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }

  .btn-secondary:hover { border-color: #f59e0b; color: #f59e0b; }

  /* ── SECTIONS ────────────────────────────────── */
  .section { padding: 48px 32px; }

  .section-wrap { max-width: 1100px; margin: 0 auto; }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .section-title {
    font-size: 20px;
    font-weight: 700;
    color: #1e293b;
  }

  .section-more {
    font-size: 13px;
    color: #d97706;
    text-decoration: none;
    font-weight: 500;
  }

  .section-more:hover { text-decoration: underline; }

  /* ── ARTICLES GRID ───────────────────────────── */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }

  .article-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s, transform 0.15s;
    display: flex;
    flex-direction: column;
  }

  .article-card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }

  .card-img-wrap {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: #f1f5f9;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    color: #cbd5e1;
    background: linear-gradient(135deg, #f8fafc, #f1f5f9);
  }

  .card-body { padding: 14px 16px; flex: 1; }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .card-lang {
    font-size: 10px;
    font-weight: 600;
    color: #92400e;
    background: #fffbf0;
    border: 1px solid #fde68a;
    padding: 2px 8px;
    border-radius: 10px;
  }

  .card-date {
    font-size: 11px;
    color: #94a3b8;
  }

  .card-title {
    font-size: 15px;
    font-weight: 600;
    color: #1e293b;
    line-height: 1.4;
    margin-bottom: 6px;
  }

  .article-card:hover .card-title { color: #d97706; }

  .card-desc {
    font-size: 12px;
    color: #64748b;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── QUICK LINKS ─────────────────────────────── */
  .quicklinks {
    padding: 0 32px 48px;
  }

  .ql-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .ql-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 20px;
    text-decoration: none;
    text-align: center;
    transition: all 0.15s;
  }

  .ql-card:hover {
    border-color: #f59e0b;
    background: #fffbf0;
    box-shadow: 0 4px 12px rgba(245,158,11,0.1);
  }

  .ql-icon {
    font-size: 28px;
    font-weight: 700;
    color: #f59e0b;
    margin-bottom: 8px;
    line-height: 1;
  }

  .ql-label {
    font-size: 15px;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 4px;
  }

  .ql-sub {
    font-size: 11px;
    color: #94a3b8;
  }

  /* ── FOOTER ──────────────────────────────────── */
  .footer {
    background: #0f172a;
    padding: 40px 32px 16px;
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
    padding-bottom: 32px;
    border-bottom: 1px solid #1e293b;
  }

  .footer-brand-ml {
    font-size: 22px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 2px;
  }

  .footer-brand-en {
    font-size: 10px;
    font-weight: 600;
    color: #f59e0b;
    letter-spacing: 0.15em;
    margin-bottom: 10px;
  }

  .footer-tagline {
    font-size: 12px;
    color: #475569;
    line-height: 1.6;
  }

  .footer-links-block {
    display: flex;
    gap: 40px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-col-title {
    font-size: 11px;
    font-weight: 600;
    color: #64748b;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .footer-link {
    font-size: 13px;
    color: #475569;
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-link:hover { color: #f59e0b; }

  .footer-bottom {
    max-width: 1100px;
    margin: 16px auto 0;
    font-size: 11px;
    color: #334155;
    text-align: center;
  }

  /* ── MOBILE ──────────────────────────────────── */
  @media (max-width: 640px) {
    .navbar { padding: 12px 16px; }

    .nav-links {
      display: none;
      position: absolute;
      top: 60px;
      left: 0;
      right: 0;
      background: #fffbf0;
      flex-direction: column;
      padding: 16px 24px;
      gap: 16px;
      border-bottom: 2px solid #f59e0b;
      z-index: 99;
    }

    .nav-links.open { display: flex; }
    .nav-toggle { display: block; }

    .hero { padding: 48px 20px; }
    .hero-title-ml { font-size: 36px; }

    .section { padding: 32px 16px; }
    .quicklinks { padding: 0 16px 32px; }

    .articles-grid { grid-template-columns: 1fr; }
    .ql-grid { grid-template-columns: repeat(2, 1fr); }

    .footer { padding: 32px 16px 16px; }
    .footer-inner { flex-direction: column; gap: 24px; }
    .footer-links-block { gap: 24px; }
  }
</style>
