---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ArticlesByLanguageSidebar from "../components/ArticlesByLanguageSidebar.astro";
import NewsByLanguageSidebar from "../components/NewsByLanguageSidebar.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";

const allArticles = await getCollection("blog");

// Show latest 4 articles on homepage
const recentArticles = allArticles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const allNews = await getCollection("news");

// Show latest 4 articles on homepage
const recentNews = allNews
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const showWelcomeSlide = true; // Set to true to show

// CAROUSEL: Featured articles, news & custom slides - EASILY EDITABLE
// Pick specific items by their ID (folder/file name)
// Example IDs: 'en/city-on-a-hill', 'ml/arise-and-shine', etc.
const carouselSlides = [
  { type: "news", id: "ml/mahanaim-43rd-graduation" },
  { type: "news", id: "ml/gospel-meetings" },
  { type: "article", id: "en/can-god-lean-on-you" },
  { type: "article", id: "ml/peace" },

  // Custom announcement slides
  // {
  //   type: "announcement",
  //   title: "New Publication Released",
  //   subtitle: "Check out our latest edition",
  //   language: "en",
  // },
];

const LANG_LABELS: Record<string, string> = {
  en: "English",
  ml: "മലയാളം",
  hi: "हिंदी",
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Navbar />

    <!-- ── CAROUSEL ───────────────────────────────── -->
    <section class="carousel">
      <div class="carousel-inner">
        {
          showWelcomeSlide && (
            // <!-- Welcome Slide -->
            <div class="carousel-item carousel-welcome-item">
              <div class="carousel-welcome">
                <h1 class="welcome-title">
                  <img src="/sadhwartha_ml.png" alt="സദ്വാർത്ത" />
                  <span class="welcome-en">
                    An official publication of Church of God (Full Gospel) in
                    India, Central West Region
                  </span>
                </h1>
              </div>
            </div>
          )
        }

        {
          carouselSlides.map((slide) => {
            // Articles in the carousel
            if (slide.type === "article") {
              const article = allArticles.find((a) => a.id === slide.id);

              if (!article) return null;

              return (
                <a
                  href={`/blog/${article.id}`}
                  class="carousel-item carousel-article-item"
                >
                  <div class="carousel-img-wrap">
                    {article.data.heroImage ? (
                      <img
                        src={article.data.heroImage.src}
                        alt={article.data.title}
                        class="carousel-img"
                      />
                    ) : (
                      <div class="carousel-img-placeholder">✝</div>
                    )}
                  </div>

                  <div class="carousel-overlay" />

                  <div class="carousel-content">
                    <div class="carousel-meta">
                      <span class="carousel-lang">
                        {LANG_LABELS[article.data.language] ??
                          article.data.language}
                      </span>
                    </div>

                    <h2 class="carousel-title">{article.data.title}</h2>

                    <p class="carousel-desc">{article.data.description}</p>
                  </div>
                </a>
              );
            }

            // News in the carousel
            if (slide.type === "news") {
              const newsItem = allNews.find((n) => n.id === slide.id);

              if (!newsItem) return null;

              return (
                <a
                  href={`/news/${newsItem.id}`}
                  class="carousel-item carousel-news-item"
                >
                  <div class="carousel-img-wrap">
                    {newsItem.data.heroImage ? (
                      <img
                        src={newsItem.data.heroImage.src}
                        alt={newsItem.data.title}
                        class="carousel-img"
                      />
                    ) : (
                      <div class="carousel-img-placeholder">📰</div>
                    )}
                  </div>

                  <div class="carousel-overlay" />

                  <div class="carousel-content">
                    <div class="carousel-meta">
                      <span class="carousel-news-badge">News</span>

                      <span class="carousel-lang">
                        {LANG_LABELS[newsItem.data.language] ??
                          newsItem.data.language}
                      </span>
                    </div>

                    <h2 class="carousel-title">{newsItem.data.title}</h2>

                    <p class="carousel-desc">{newsItem.data.description}</p>
                  </div>
                </a>
              );
            }

            // Announcements in the carousel
            // return (
            //   <div class="carousel-item carousel-announcement-item">
            //     <div class="carousel-overlay" />

            //     <div class="carousel-content">
            //       <h2 class="carousel-title">{slide.title}</h2>
            //       <p class="carousel-desc">{slide.subtitle}</p>
            //     </div>
            //   </div>
            // );
          })
        }
      </div>

      <!-- Navigation Buttons -->
      <button class="carousel-btn carousel-btn-prev" aria-label="Previous slide"
        >❮</button
      >
      <button class="carousel-btn carousel-btn-next" aria-label="Next slide"
        >❯</button
      >

      <!-- Dots -->
      <div class="carousel-dots">
        {
          showWelcomeSlide && (
            <button
              class="dot active"
              data-slide="0"
              aria-label="Welcome slide"
            />
          )
        }
        {
          [...Array(carouselSlides.length)].map((_, index) => (
            <button
              class={`dot ${!showWelcomeSlide && index === 0 ? "active" : ""}`}
              data-slide={showWelcomeSlide ? index + 1 : index}
              aria-label={`Slide ${index + (showWelcomeSlide ? 2 : 1)}`}
            />
          ))
        }
      </div>
    </section>

    <!-- ── HOME LAYOUT: LEFT SIDEBAR | MAIN | RIGHT SIDEBAR ─ -->
    <section class="home-layout">
      <div class="home-sidebar home-sidebar-left">
        <ArticlesByLanguageSidebar
          articles={allArticles}
          title="Articles"
        />
      </div>

      <div class="home-main">
        <!-- ── RECENT ARTICLES ───────────────────────── -->
        <div class="section">
          <div class="section-header">
            <h2 class="section-title">Recent Articles</h2>
            <a href="/blog" class="section-more">View all →</a>
          </div>

          <div class="articles-grid">
            {
              recentArticles.map((article) => (
                <a href={`/blog/${article.id}`} class="article-card">
                  <div class="card-img-wrap">
                    {article.data.heroImage ? (
                      <img
                        src={article.data.heroImage.src}
                        alt={article.data.title}
                        class="card-img"
                      />
                    ) : (
                      <div class="card-img-placeholder">✝</div>
                    )}
                  </div>
                  <div class="card-body">
                    <div class="card-meta">
                      {/* <span class="card-lang">{LANG_LABELS[article.data.language] ?? article.data.language}</span> */}
                      <span class="card-date">
                        {new Date(article.data.pubDate).toLocaleDateString(
                          "en-IN",
                          {
                            day: "numeric",
                            month: "short",
                            year: "numeric",
                          },
                        )}
                      </span>
                    </div>
                    <div class="card-title">{article.data.title}</div>
                    <div class="card-desc">{article.data.description}</div>
                    {/* <div><h5>{article.data.author}</h5></div> */}
                  </div>
                </a>
              ))
            }
          </div>
        </div>

        <!-- ── RECENT NEWS ────────────────────────────── -->
        <div class="section">
          <div class="section-header">
            <h2 class="section-title">Recent News</h2>
            <a href="/news" class="section-more">View all →</a>
          </div>

          <div class="articles-grid">
            {
              recentNews.map((newsItem) => (
                <a href={`/news/${newsItem.id}`} class="article-card">
                  <div class="card-img-wrap">
                    {newsItem.data.heroImage ? (
                      <img
                        src={newsItem.data.heroImage.src}
                        alt={newsItem.data.title}
                        class="card-img"
                      />
                    ) : (
                      <div class="card-img-placeholder">📰</div>
                    )}
                  </div>

                  <div class="card-body">
                    <div class="card-meta">
                      <span class="card-date">
                        {new Date(newsItem.data.pubDate).toLocaleDateString(
                          "en-IN",
                          {
                            day: "numeric",
                            month: "short",
                            year: "numeric",
                          },
                        )}
                      </span>
                    </div>

                    <div class="card-title">{newsItem.data.title}</div>

                    <div class="card-desc">{newsItem.data.description}</div>
                  </div>
                </a>
              ))
            }
          </div>
        </div>

        <!-- ── QUICK LINKS ───────────────────────────── -->
        <div class="quicklinks">
          <div class="ql-grid">
            <a href="/blog?lang=ml" class="ql-card">
              <div class="ql-icon">മ</div>
              <div class="ql-label">മലയാളം</div>
              <div class="ql-sub">Malayalam Articles</div>
            </a>
            <a href="/blog?lang=hi" class="ql-card">
              <div class="ql-icon">हि</div>
              <div class="ql-label">हिंदी</div>
              <div class="ql-sub">Hindi Articles</div>
            </a>
            <a href="/blog?lang=en" class="ql-card">
              <div class="ql-icon">En</div>
              <div class="ql-label">English</div>
              <div class="ql-sub">English Articles</div>
            </a>
            <a href="/contact" class="ql-card">
              <div class="ql-icon">✉</div>
              <div class="ql-label">Contact</div>
              <div class="ql-sub">Get in touch</div>
            </a>
            <a href="/archive" class="ql-card">
              <div class="ql-icon">lll</div>
              <div class="ql-label">Archive</div>
              <div class="ql-sub">Previous Editions</div>
            </a>
          </div>
        </div>
      </div>

      <div class="home-sidebar home-sidebar-right">
        <NewsByLanguageSidebar newsItems={allNews} title="News" />
      </div>
    </section>

    <Footer />
  </body>
</html>

<script>
  // Carousel autorotation
  const carouselInner = document.querySelector(
    ".carousel-inner",
  ) as HTMLElement | null;
  const dots = document.querySelectorAll(".dot");
  let currentSlide = 0;
  const totalSlides = dots.length;
  const rotationInterval = 4000; // 4 seconds

  function goToSlide(n: number): void {
    if (!carouselInner) return;
    currentSlide = (n + totalSlides) % totalSlides;
    carouselInner.style.transform = `translateX(-${currentSlide * 100}%)`;

    // Update dots
    dots.forEach((dot, index) => {
      dot.classList.toggle("active", index === currentSlide);
    });
  }

  function nextSlide(): void {
    goToSlide(currentSlide + 1);
  }

  // Auto-rotate carousel
  setInterval(nextSlide, rotationInterval);

  // Dot click handlers
  dots.forEach((dot) => {
    dot.addEventListener("click", (e: Event) => {
      const target = e.target as HTMLElement;
      goToSlide(parseInt(target.dataset.slide ?? "0"));
    });
  });

  // Arrow button handlers
  const prevBtn = document.querySelector(
    ".carousel-btn-prev",
  ) as HTMLElement | null;
  const nextBtn = document.querySelector(
    ".carousel-btn-next",
  ) as HTMLElement | null;

  if (prevBtn) {
    prevBtn.addEventListener("click", () => goToSlide(currentSlide - 1));
  }

  if (nextBtn) {
    nextBtn.addEventListener("click", () => nextSlide());
  }

  // Touch swipe support for mobile
  let touchStartX = 0;
  let touchEndX = 0;
  const swipeThreshold = 50; // Minimum swipe distance in pixels
  const carousel = document.querySelector(".carousel") as HTMLElement | null;

  if (carousel) {
    carousel.addEventListener(
      "touchstart",
      (e: TouchEvent) => {
        touchStartX = e.changedTouches[0].clientX;
      },
      false,
    );

    carousel.addEventListener(
      "touchend",
      (e: TouchEvent) => {
        touchEndX = e.changedTouches[0].clientX;
        handleSwipe();
      },
      false,
    );
  }

  function handleSwipe(): void {
    const swipeDistance = touchStartX - touchEndX;

    // Swipe left (positive distance) = next slide
    if (swipeDistance > swipeThreshold) {
      nextSlide();
    }
    // Swipe right (negative distance) = prev slide
    else if (swipeDistance < -swipeThreshold) {
      goToSlide(currentSlide - 1);
    }
  }
</script>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--bg-page);
    font-family: var(--font-body);
  }

  /* ── CAROUSEL ────────────────────────────────── */
  .carousel {
    position: relative;
    width: 100%;
    height: 250px;
    overflow: hidden;
    margin-top: var(--navbar-height);
    background: linear-gradient(
      135deg,
      var(--slate) 0%,
      #0f172a 60%,
      #1c1917 100%
    );
  }

  .carousel-inner {
    display: flex;
    height: 100%;
    transition: transform 0.6s ease-in-out;
  }

  .carousel-item {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  /* Welcome Slide */
  .carousel-welcome-item {
    background: linear-gradient(
      135deg,
      var(--slate) 0%,
      #0f172a 60%,
      #1c1917 100%
    );
  }

  .carousel-welcome {
    text-align: center;
    max-width: 640px;
    padding: 40px;
  }

  .welcome-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    opacity: 0;
    filter: blur(20px);
    transform: scale(1.2);
    animation: logoReveal 2s ease-out forwards;
  }

  .welcome-title img {
    filter: brightness(0) invert(1);
  }

  @keyframes logoReveal {
    to {
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }
  }

  .welcome-en {
    font-size: 11px;
    font-weight: 700;
    color: wheat;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .welcome-sub {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 10px;
  }

  .welcome-actions {
    display: none;
  }

  /* Article Slides */
  .carousel-article-item {
    background: #000;
    color: var(--bg-white);
    text-decoration: none;
  }

  /* News Slides */
  .carousel-news-item {
    background: #000;
    color: var(--bg-white);
    text-decoration: none;
  }

  /* Announcement Slides */
  .carousel-announcement-item {
    background: linear-gradient(135deg, var(--red) 0%, #b01f1f 100%);
    color: var(--bg-white);
  }

  .carousel-img-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .carousel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .carousel-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 80px;
    color: rgba(255, 255, 255, 0.1);
    background: linear-gradient(135deg, var(--slate), #0f172a);
  }

  .carousel-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.2));
  }

  .carousel-content {
    position: absolute;
    bottom: 40px;
    left: 40px;
    right: 40px;
    z-index: 10;
    max-width: 600px;
  }

  .carousel-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .carousel-lang {
    font-size: 10px;
    font-weight: 600;
    color: var(--bg-white);
    background: var(--red);
    padding: 4px 10px;
    border-radius: 10px;
  }

  .carousel-news-badge {
    font-size: 10px;
    font-weight: 600;
    color: var(--bg-white);
    background: var(--orange);
    padding: 4px 10px;
    border-radius: 10px;
  }

  .carousel-title {
    font-size: 28px;
    font-weight: 700;
    color: var(--bg-white);
    line-height: 1.3;
    margin-bottom: 8px;
  }

  .carousel-desc {
    font-size: 13px;
    color: var(--border-light);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Carousel Dots */
  .carousel-dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 20;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    border: none;
    cursor: pointer;
    transition: background 0.3s;
  }

  .dot.active {
    background: var(--red);
  }

  .dot:hover {
    background: rgba(255, 255, 255, 0.7);
  }

  /* Carousel Navigation Buttons */
  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 15;
    width: 36px;
    height: 36px;
    border: none;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 18px;
    font-weight: 600;
    cursor: pointer;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background 0.3s,
      transform 0.2s;
    opacity: 0.6;
  }

  .carousel-btn:hover {
    background: rgba(255, 255, 255, 0.25);
    opacity: 1;
    transform: translateY(-50%) scale(1.05);
  }

  .carousel-btn:active {
    transform: translateY(-50%) scale(0.95);
  }

  .carousel-btn-prev {
    left: 16px;
  }

  .carousel-btn-next {
    right: 16px;
  }

  /* ── TABLET (768px to 1024px) ────────────────── */
  @media (max-width: 1024px) {
    .carousel {
      height: 350px;
    }

    .carousel-content {
      bottom: 30px;
      left: 30px;
      right: 30px;
    }

    .carousel-title {
      font-size: 22px;
      margin-bottom: 6px;
    }

    .carousel-desc {
      font-size: 12px;
      -webkit-line-clamp: 2;
    }
  }

  .btn-primary {
    padding: 10px 24px;
    background: var(--red);
    color: var(--bg-white);
    font-weight: 600;
    font-size: 14px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s;
  }

  .btn-primary:hover {
    background: #b01f1f;
  }

  .btn-secondary {
    padding: 10px 24px;
    background: transparent;
    color: var(--border-light);
    font-weight: 500;
    font-size: 14px;
    border-radius: 8px;
    border: 1px solid var(--text-dark);
    text-decoration: none;
    transition:
      border-color 0.15s,
      color 0.15s;
  }

  .btn-secondary:hover {
    border-color: var(--red);
    color: var(--red);
  }

  /* ── HOME LAYOUT (LEFT | MAIN | RIGHT) ───────── */
  .home-layout {
    display: grid;
    grid-template-columns: 260px 1fr 280px;
    gap: 24px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 32px 32px 0;
    align-items: start;
  }

  .home-sidebar-left {
    order: 1;
  }

  .home-main {
    order: 2;
    min-width: 0;
  }

  .home-sidebar-right {
    order: 3;
  }

  /* ── SECTIONS (now nested inside .home-main) ── */
  .section {
    padding: 0 0 40px;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .section-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .section-more {
    font-size: 13px;
    color: var(--red);
    text-decoration: none;
    font-weight: 500;
  }

  .section-more:hover {
    text-decoration: underline;
  }

  /* ── ARTICLES GRID ───────────────────────────── */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }

  .article-card {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      box-shadow 0.15s,
      transform 0.15s;
    display: flex;
    flex-direction: column;
  }

  .article-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  .card-img-wrap {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--bg-page);
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: fill;
    display: block;
  }

  .card-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    color: #cbd5e1;
    background: linear-gradient(135deg, #f8fafc, #f1f5f9);
  }

  .card-body {
    padding: 14px 16px;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .card-lang {
    font-size: 10px;
    font-weight: 600;
    color: var(--red);
    background: var(--orange-light);
    border: 1px solid var(--red);
    padding: 2px 8px;
    border-radius: 10px;
  }

  .card-date {
    font-size: 11px;
    color: var(--text-muted);
  }

  .card-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
    margin-bottom: 6px;
  }

  .article-card:hover .card-title {
    color: var(--red);
  }

  .card-desc {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── QUICK LINKS ─────────────────────────────── */
  .quicklinks {
    padding: 0 0 8px;
  }

