---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  language?: string;
  heroImage?: string;
}

const { title, description, pubDate, language, heroImage } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
  </head>
  <body>

    <nav class="navbar">
      <a href="/" class="nav-brand">SADHWARTHA</a>
      <div class="nav-links">
        <a href="/" class="nav-link">Home</a>
        <a href="/blog" class="nav-link">Articles</a>
        <a href="/archive" class="nav-link">Archive</a>
        <a href="/news" class="nav-link">News</a>
        <a href="/about" class="nav-link">About</a>
        <a href="/contact" class="nav-link">Contact</a>
      </div>
    </nav>

    <div class="article-wrap">

      <div class="article-header">
        <a href="/blog" class="back-link">← All Articles</a>
        <div class="article-meta">
          <span class="article-date">{formattedDate}</span>
          {language && <span class="lang-badge">{language}</span>}
        </div>
        <h1 class="article-title">{title}</h1>
        <p class="article-description">{description}</p>
        <div class="header-divider"></div>
      </div>

      {heroImage && (
        <img src={heroImage} alt={title} class="hero-image" />
      )}

      <div class="article-body">
        <slot />
      </div>

      <div class="article-footer">
        <a href="/blog" class="back-btn">← Back to Articles</a>
      </div>

    </div>

    <footer class="footer">
      <div>
        <div class="footer-brand">SADHWARTHA</div>
        <div class="footer-sub">Church of God (Full Gospel) in India, Central West Region</div>
      </div>
      <div class="footer-links">
        <a href="/blog" class="footer-link">Articles</a>
        <a href="/archive" class="footer-link">Archive</a>
        <a href="/contact" class="footer-link">Contact</a>
      </div>
    </footer>

  </body>
</html>

<style>
  body {
    background: #f1f5f9;
    font-family: system-ui, -apple-system, sans-serif;
    margin: 0;
    padding: 0 1rem;
  }

  /* NAV */
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
    background: #1e293b;
    border-radius: 12px;
    margin: 1rem auto;
    max-width: 1100px;
  }
  .nav-brand {
    font-size: 16px;
    font-weight: 500;
    color: #f59e0b;
    letter-spacing: 0.1em;
    text-decoration: none;
  }
  .nav-links { display: flex; gap: 20px; }
  .nav-link {
    font-size: 13px;
    color: #94a3b8;
    text-decoration: none;
  }
  .nav-link:hover { color: #f59e0b; }

  /* ARTICLE WRAPPER */
  .article-wrap {
    max-width: 720px;
    margin: 0 auto 2rem;
    background: #ffffff;
    border-radius: 12px;
    border: 0.5px solid #e2e8f0;
    overflow: hidden;
  }

  /* ARTICLE HEADER */
  .article-header {
    background: #1e293b;
    padding: 28px 32px 24px;
  }
  .back-link {
    font-size: 12px;
    color: #94a3b8;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 16px;
  }
  .back-link:hover { color: #f59e0b; }
  .article-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .article-date {
    font-size: 12px;
    color: #94a3b8;
  }
  .lang-badge {
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 20px;
    background: #fef3c7;
    color: #92400e;
    border: 0.5px solid #f59e0b;
  }
  .article-title {
    font-size: 26px;
    font-weight: 500;
    color: #f59e0b;
    line-height: 1.3;
    margin-bottom: 10px;
  }
  .article-description {
    font-size: 14px;
    color: #94a3b8;
    line-height: 1.6;
  }
  .header-divider {
    width: 40px;
    height: 2px;
    background: #f59e0b;
    margin-top: 20px;
    opacity: 0.6;
  }

  /* HERO IMAGE */
  .hero-image {
    width: 100%;
    max-height: 340px;
    object-fit: cover;
  }

  /* ARTICLE BODY */
  .article-body {
    padding: 32px;
    font-size: 16px;
    color: #334155;
    line-height: 1.8;
  }
  .article-body h2 {
    font-size: 20px;
    font-weight: 500;
    color: #1e293b;
    margin: 2rem 0 0.75rem;
    padding-bottom: 6px;
    border-bottom: 1px solid #f1f5f9;
  }
  .article-body h3 {
    font-size: 17px;
    font-weight: 500;
    color: #1e293b;
    margin: 1.5rem 0 0.5rem;
  }
  .article-body p {
    margin-bottom: 1.2rem;
  }
  .article-body blockquote {
    border-left: 3px solid #f59e0b;
    margin: 1.5rem 0;
    padding: 10px 20px;
    background: #fefce8;
    border-radius: 0 8px 8px 0;
    font-style: italic;
    color: #64748b;
  }
  .article-body a {
    color: #f59e0b;
    text-decoration: underline;
  }
  .article-body ul, .article-body ol {
    padding-left: 1.5rem;
    margin-bottom: 1.2rem;
  }
  .article-body li {
    margin-bottom: 0.4rem;
  }
  .article-body strong {
    color: #1e293b;
    font-weight: 500;
  }

  /* ARTICLE FOOTER */
  .article-footer {
    padding: 20px 32px;
    border-top: 0.5px solid #f1f5f9;
  }
  .back-btn {
    font-size: 12px;
    color: #1e293b;
    border: 0.5px solid #1e293b;
    border-radius: 8px;
    padding: 6px 14px;
    text-decoration: none;
    display: inline-block;
  }
  .back-btn:hover {
    background: #1e293b;
    color: #f59e0b;
  }

  /* FOOTER */
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #1e293b;
    border-radius: 12px;
    padding: 16px 24px;
    margin: 0 auto 1rem;
    max-width: 1100px;
  }
  .footer-brand {
    font-size: 13px;
    font-weight: 500;
    color: #f59e0b;
    letter-spacing: 0.08em;
  }
  .footer-sub {
    font-size: 11px;
    color: #64748b;
    margin-top: 2px;
  }
  .footer-links { display: flex; gap: 16px; }
  .footer-link {
    font-size: 11px;
    color: #64748b;
    text-decoration: none;
  }
  .footer-link:hover { color: #f59e0b; }

  /* MOBILE */
  @media (max-width: 768px) {
    .nav-links { gap: 12px; flex-wrap: wrap; }
    .article-header { padding: 20px; }
    .article-body { padding: 20px; }
    .article-footer { padding: 16px 20px; }
    .article-title { font-size: 22px; }
    .footer { flex-direction: column; gap: 12px; text-align: center; }
  }
</style>