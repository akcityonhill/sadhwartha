---
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE } from "../consts";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "" } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
  </head>
  <body>
    <nav class="navbar">
      <a href="/" class="nav-brand">SADHWARTHA</a>
      <div class="nav-links">
        <a href="/" class="nav-link">Home</a>
        <a href="/blog" class="nav-link">Articles</a>
        <a href="/archive" class="nav-link">Archive</a>
        <a href="/news" class="nav-link">News</a>
        <a href="/about" class="nav-link">About</a>
        <a href="/contact" class="nav-link">Contact</a>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div>
        <div class="footer-brand">SADHWARTHA</div>
        <div class="footer-sub">
          Church of God (Full Gospel) in India, Central West Region
        </div>
      </div>
      <div class="footer-links">
        <a href="/blog" class="footer-link">Articles</a>
        <a href="/archive" class="footer-link">Archive</a>
        <a href="/contact" class="footer-link">Contact</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
    background: var(--slate);
    border-radius: 12px;
    margin: 1rem auto;
    max-width: 1100px;
  }

  .nav-brand {
    font-size: 16px;
    font-weight: 500;
    color: var(--orange-light);   /* was --amber, which doesn't exist */
    letter-spacing: 0.1em;
    font-family: var(--font-ui);  /* UI chrome stays sans-serif */
  }

  .nav-links {
    display: flex;
    gap: 20px;
  }

  .nav-link {
    font-size: 13px;
    color: var(--text-muted);
    font-family: var(--font-ui);
  }

  .nav-link:hover {
    color: var(--orange-light);   /* was --amber */
  }

  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--slate);
    border-radius: 12px;
    padding: 16px 24px;
    margin: 2rem auto 1rem;
    max-width: 1100px;
  }

  .footer-brand {
    font-size: 13px;
    font-weight: 500;
    color: var(--orange-light);   /* was --amber */
    letter-spacing: 0.08em;
    font-family: var(--font-ui);
  }

  .footer-sub {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 2px;
    font-family: var(--font-ui);
  }

  .footer-links {
    display: flex;
    gap: 16px;
  }

  .footer-link {
    font-size: 11px;
    color: var(--text-muted);
    font-family: var(--font-ui);
  }

  .footer-link:hover {
    color: var(--orange-light);   /* was --amber */
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1rem;
  }
</style>