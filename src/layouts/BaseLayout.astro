---
import '../styles/global.css';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {SITE_TITLE}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>

    <nav class="navbar">
      <a href="/" class="nav-brand">SADHWARTHA</a>
      <div class="nav-links">
        <a href="/" class="nav-link">Home</a>
        <a href="/articles" class="nav-link">Articles</a>
        <a href="/archive" class="nav-link">Archive</a>
        <a href="/news" class="nav-link">News</a>
        <a href="/about" class="nav-link">About</a>
        <a href="/contact" class="nav-link">Contact</a>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div>
        <div class="footer-brand">SADHWARTHA</div>
        <div class="footer-sub">Church of God (Full Gospel) in India, Central West Region</div>
      </div>
      <div class="footer-links">
        <a href="/articles" class="footer-link">Articles</a>
        <a href="/archive" class="footer-link">Archive</a>
        <a href="/contact" class="footer-link">Contact</a>
      </div>
    </footer>

  </body>
</html>

<style>
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
    background: var(--slate);
    border-radius: 12px;
    margin: 1rem auto;
    max-width: 1100px;
  }
  .nav-brand {
    font-size: 16px;
    font-weight: 500;
    color: var(--amber);
    letter-spacing: 0.1em;
  }
  .nav-links {
    display: flex;
    gap: 20px;
  }
  .nav-link {
    font-size: 13px;
    color: var(--text-muted);
  }
  .nav-link:hover {
    color: var(--amber);
  }
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--slate);
    border-radius: 12px;
    padding: 16px 24px;
    margin: 2rem auto 1rem;
    max-width: 1100px;
  }
  .footer-brand {
    font-size: 13px;
    font-weight: 500;
    color: var(--amber);
    letter-spacing: 0.08em;
  }
  .footer-sub {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 2px;
  }
  .footer-links {
    display: flex;
    gap: 16px;
  }
  .footer-link {
    font-size: 11px;
    color: var(--text-muted);
  }
  .footer-link:hover {
    color: var(--amber);
  }
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1rem;
  }
</style>